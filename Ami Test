# -------------------------------------------------------------
# Lightweight GP (RBF + white noise)
# -------------------------------------------------------------
class _SimpleGP:
    """
    RBF kernel with two shared length-scales:
      - one for 5 continuous dims
      - one for 3 one-hot categorical dims
    Plus signal variance and noise variance.
    theta = [log_ell_cont, log_ell_cat, log_sigma, log_noise]
    """
    def __init__(self):
        self.X = None
        self.y = None
        self.theta = None
        self.L = None
        self.alpha = None

    def _kernel(self, XA, XB, ell_cont, ell_cat, sigma2):
        XA_c, XA_k = XA[:, :5], XA[:, 5:]
        XB_c, XB_k = XB[:, :5], XB[:, 5:]
        A_c = XA_c / (ell_cont + 1e-12)
        B_c = XB_c / (ell_cont + 1e-12)
        d2_c = np.sum(A_c**2, axis=1)[:, None] + np.sum(B_c**2, axis=1)[None, :] - 2.0 * (A_c @ B_c.T)
        A_k = XA_k / (ell_cat + 1e-12)
        B_k = XB_k / (ell_cat + 1e-12)
        d2_k = np.sum(A_k**2, axis=1)[:, None] + np.sum(B_k**2, axis=1)[None, :] - 2.0 * (A_k @ B_k.T)
        return sigma2 * np.exp(-0.5 * (d2_c + d2_k))

    def _neg_log_mll(self, logtheta):
        log_ell_cont, log_ell_cat, log_sigma, log_noise = logtheta
        ell_cont = np.exp(log_ell_cont)
        ell_cat  = np.exp(log_ell_cat)
        sigma2   = np.exp(2.0 * log_sigma)
        noise2   = np.exp(2.0 * log_noise)

        K = self._kernel(self.X, self.X, ell_cont, ell_cat, sigma2)
        n = self.X.shape[0]
        K[np.diag_indices(n)] += noise2 + 1e-10
        try:
            L, lower = cho_factor(K, lower=True, check_finite=False)
            alpha = cho_solve((L, lower), self.y, check_finite=False)
            logdet = 2.0 * np.sum(np.log(np.diag(L)))
            return 0.5 * (self.y @ alpha) + 0.5 * logdet + 0.5 * n * np.log(2.0 * np.pi)
        except np.linalg.LinAlgError:
            return 1e50

    def fit(self, X_enc, y, optimize_hyperparams=True, maxfun=60):
        self.X = np.asarray(X_enc, float)
        self.y = np.asarray(y, float)

        if self.theta is None:
            self.theta = np.array([np.log(0.5), np.log(0.5), np.log(1.0), np.log(1e-2)])

        if optimize_hyperparams and len(self.y) >= 6:
            res = minimize(self._neg_log_mll, self.theta, method='L-BFGS-B',
                           options={'maxfun': maxfun, 'maxiter': maxfun, 'ftol': 1e-6})
            self.theta = res.x

        log_ell_cont, log_ell_cat, log_sigma, log_noise = self.theta
        ell_cont = np.exp(log_ell_cont)
        ell_cat  = np.exp(log_ell_cat)
        sigma2   = np.exp(2.0 * log_sigma)
        noise2   = np.exp(2.0 * log_noise)

        K = self._kernel(self.X, self.X, ell_cont, ell_cat, sigma2)
        n = self.X.shape[0]
        K[np.diag_indices(n)] += noise2 + 1e-10
        self.L, lower = cho_factor(K, lower=True, check_finite=False)
        self.alpha = cho_solve((self.L, lower), self.y, check_finite=False)

    def predict(self, Xstar_enc):
        Xstar_enc = np.asarray(Xstar_enc, float)
        log_ell_cont, log_ell_cat, log_sigma, _ = self.theta
        ell_cont = np.exp(log_ell_cont)
        ell_cat  = np.exp(log_ell_cat)
        sigma2   = np.exp(2.0 * log_sigma)

        Kxs = self._kernel(Xstar_enc, self.X, ell_cont, ell_cat, sigma2)
        mu  = Kxs @ self.alpha
        v   = cho_solve((self.L, True), Kxs.T, check_finite=False)
        kss = sigma2 * np.ones(Xstar_enc.shape[0])
        var = kss - np.sum(Kxs * v.T, axis=1)
        std = np.sqrt(np.maximum(var, 1e-12))
        return mu, std

    def _refactor_fixed_theta(self):
        log_ell_cont, log_ell_cat, log_sigma, log_noise = self.theta
        ell_cont = np.exp(log_ell_cont)
        ell_cat  = np.exp(log_ell_cat)
        sigma2   = np.exp(2.0 * log_sigma)
        noise2   = np.exp(2.0 * log_noise)

        K = self._kernel(self.X, self.X, ell_cont, ell_cat, sigma2)
        n = self.X.shape[0]
        K[np.diag_indices(n)] += noise2 + 1e-10
        self.L, lower = cho_factor(K, lower=True, check_finite=False)
        self.alpha = cho_solve((self.L, lower), self.y, check_finite=False)

# -------------------------------------------------------------
# EI acquisition (no scipy.stats)
# -------------------------------------------------------------
def _erf_approx(z):
    sign = np.sign(z)
    x = np.abs(z)
    p = 0.3275911
    a1,a2,a3,a4,a5 = 0.254829592, -0.284496736, 1.421413741, -1.453152027, 1.061405429
    t = 1.0/(1.0 + p*x)
    poly = (((a5*t + a4)*t + a3)*t + a2)*t + a1
    y = 1.0 - poly * np.exp(-x*x)
    return sign * y

def _expected_improvement(mu, std, f_best, eps=1e-9):
    std = np.maximum(std, eps)
    z = (mu - f_best) / std
    pdf = np.exp(-0.5 * z**2) / np.sqrt(2.0 * np.pi)
    cdf = 0.5 * (1.0 + _erf_approx(z / np.sqrt(2.0)))
    ei = (mu - f_best) * cdf + std * pdf
    ei[std < eps] = 0.0
    return ei

# -------------------------------------------------------------
# BO class (matches example style: runs in __init__, tracks time)
# -------------------------------------------------------------
class BO:
    def __init__(self, X_initial, X_searchspace, iterations, batch, objective_func):
        start_time = datetime.timestamp(datetime.now())

        self.X_initial     = X_initial
        self.X_searchspace = X_searchspace
        self.iterations    = iterations
        self.batch         = batch

        # Initial evaluation and timing format like the example
        self.Y     = objective_func(self.X_initial)
        self.time  = [datetime.timestamp(datetime.now()) - start_time]
        self.time += [0] * (len(self.X_initial) - 1)
        start_time = datetime.timestamp(datetime.now())

        # Bounds for scaling (from grids)
        self.bounds = {
            'temp': (30.0, 40.0),
            'pH':   (6.0, 8.0),
            'f1':   (0.0, 50.0),
            'f2':   (0.0, 50.0),
            'f3':   (0.0, 50.0),
        }
        self.celltypes = ['celltype_1','celltype_2','celltype_3']

        # Encode pool; mark already evaluated
        self.pool_native = list(self.X_searchspace)
        self.pool_enc    = self._encode_batch(self.pool_native)
        done = set(tuple(x) for x in self.X_initial)
        self.taken_mask = np.array([tuple(x) in done for x in self.pool_native], dtype=bool)

        # Fit initial GP
        self.gp = _SimpleGP()
        X0_enc = self._encode_batch(self.X_initial)
        self.gp.fit(X0_enc, self.Y, optimize_hyperparams=True)

        # Main loop
        for self.iteration in range(iterations):
            y_best = float(np.max(self.Y))
            batch_points, chosen_idx = self._select_batch_kb(y_best, self.batch, self.taken_mask.copy())
            if len(batch_points) == 0:
                break

            Y_new = objective_func(batch_points)
            self.Y = np.concatenate([self.Y, Y_new])

            for idx in chosen_idx:
                self.taken_mask[idx] = True

            # timing pattern: leader time + zeros
            self.time += [datetime.timestamp(datetime.now()) - start_time]
            self.time += [0] * (len(Y_new) - 1)
            start_time = datetime.timestamp(datetime.now())

            # Refit GP; re-optimise occasionally
            X_all_native = self._history_native(self.pool_native, self.taken_mask, self.X_initial)
            X_all_enc    = self._encode_batch(X_all_native)
            opt_h = (len(self.Y) >= 12 and self.iteration % 3 == 0)
            self.gp.fit(X_all_enc, self.Y, optimize_hyperparams=opt_h)

    # ---------- encoding helpers ----------
    def _one_hot_celltype(self, ct):
        oh = np.zeros(3)
        oh[self.celltypes.index(ct)] = 1.0
        return oh

    def _scale(self, x, lo, hi):
        return (float(x) - lo) / (hi - lo + 1e-12)

    def _encode_point(self, x_native):
        t, pH, f1, f2, f3, ct = x_native
        cont = np.array([
            self._scale(t,  *self.bounds['temp']),
            self._scale(pH, *self.bounds['pH']),
            self._scale(f1, *self.bounds['f1']),
            self._scale(f2, *self.bounds['f2']),
            self._scale(f3, *self.bounds['f3']),
        ])
        cat = self._one_hot_celltype(ct)
        return np.concatenate([cont, cat], axis=0)

    def _encode_batch(self, X_native):
        return np.vstack([self._encode_point(x) for x in X_native])

    # ---------- batch selection: EI + Kriging Believer ----------
    def _select_batch_kb(self, y_best, batch_size, taken_mask_copy):
        chosen_idxs = []

        believer = _SimpleGP()
        believer.X = self.gp.X.copy()
        believer.y = self.gp.y.copy()
        believer.theta = self.gp.theta
        believer.L = self.gp.L
        believer.alpha = self.gp.alpha

        for _ in range(batch_size):
            valid = ~taken_mask_copy
            if not np.any(valid):
                break
            mu, std = believer.predict(self.pool_enc[valid])
            ei = _expected_improvement(mu, std, y_best)
            if np.all(ei <= 0.0):
                # fallback to random unexplored points if EI is flat
                j_pool = np.random.choice(np.where(valid)[0])
            else:
                j_valid = int(np.argmax(ei))
                j_pool  = np.where(valid)[0][j_valid]


            j_valid = int(np.argmax(ei))
            j_pool  = np.where(valid)[0][j_valid]

            x_new_enc = self.pool_enc[j_pool:j_pool+1]
            mu_new, _ = believer.predict(x_new_enc)

            believer.X = np.vstack([believer.X, x_new_enc])
            believer.y = np.concatenate([believer.y, mu_new])
            believer._refactor_fixed_theta()

            taken_mask_copy[j_pool] = True
            chosen_idxs.append(j_pool)

        batch_native = [self.pool_native[i] for i in chosen_idxs]
        return batch_native, chosen_idxs

    def _history_native(self, pool_native, taken_mask, X_initial):
        xset = list(X_initial)
        init_set = set(tuple(xx) for xx in X_initial)
        for take, x in zip(taken_mask, pool_native):
            if take and (tuple(x) not in init_set):
                xset.append(x)
        return xset

