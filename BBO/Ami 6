# -------------------------------------------------------------
# Gaussian Process model (with ML-II hyperparameter optimisation)
# -------------------------------------------------------------
class GP:
    def __init__(self):
        """
        Initialise GP hyperparameters in log-space.

        theta = [log(lc), log(lk), log(sigma), log(noise)]
        """
        self.theta = np.log([0.5, 0.5, 1.0, 1e-4])

    def kernel(self, A, B, lc, lk, s2):
        """
        Matern 5/2 kernel with separate lengthscales for:
        - Continuous variables (first 5 dimensions)
        - Categorical variables (one-hot encoded)

        This kernel structure allows mixed continuous/categorical inputs.
        """
        # Split continuous and categorical components
        A1, A2 = A[:, :5]/lc, A[:, 5:]/lk
        B1, B2 = B[:, :5]/lc, B[:, 5:]/lk

        # Squared Euclidean distance for continuous variables
        sq = np.sum(A1**2,1)[:,None] + np.sum(B1**2,1)[None,:] - 2*A1@B1.T

        # Add squared distance for categorical variables
        sq += np.sum(A2**2,1)[:,None] + np.sum(B2**2,1)[None,:] - 2*A2@B2.T

        sq = np.maximum(sq,0)
        d = np.sqrt(sq)

        # Matern 5/2 kernel formula
        sd = np.sqrt(5)*d
        return s2*(1 + sd + 5*d*d/3) * np.exp(-sd)

    def neg_log_mll(self, theta):
        """
        Negative log marginal likelihood (NLML).

        This is minimised to learn GP hyperparameters
        (Type-II Maximum Likelihood / evidence maximisation).
        """
        lc, lk, ls, ln = theta

        # Construct covariance matrix
        K = self.kernel(self.X, self.X,
                         np.exp(lc), np.exp(lk), np.exp(2*ls))

        # Add observation noise on diagonal
        K[np.diag_indices(len(self.X))] += np.exp(2*ln) + 1e-8

        # Cholesky factorisation for numerical stability
        L,_ = cho_factor(K, lower=True)

        # Solve for alpha = K^{-1} y
        alpha = cho_solve((L,True), self.y)

        # Standard GP marginal likelihood expression
        return (
            0.5*self.y@alpha
            + np.sum(np.log(np.diag(L)))
            + 0.5*len(self.y)*np.log(2*np.pi)
        )

    def fit(self, X, y):
        """
        Fit GP to observed data.

        Steps:
        1. Normalise outputs
        2. Optimise hyperparameters (ML-II)
        3. Recompute GP posterior with optimal hyperparameters
        """
        self.X = X

        # Normalise targets for numerical stability
        self.m = np.mean(y)
        self.s = np.std(y) if np.std(y) > 1e-9 else 1.0
        self.y = (y - self.m)/self.s

        # Hyperparameter optimisation via L-BFGS-B
        res = minimize(self.neg_log_mll, self.theta, method="L-BFGS-B")
        self.theta = res.x

        # Build final covariance matrix with optimised hyperparameters
        lc, lk, ls, ln = self.theta
        K = self.kernel(X,X,np.exp(lc),np.exp(lk),np.exp(2*ls))
        K[np.diag_indices(len(X))] += np.exp(2*ln) + 1e-8

        # Precompute Cholesky and alpha for predictions
        self.L,_ = cho_factor(K, lower=True)
        self.alpha = cho_solve((self.L,True), self.y)

    def predict(self, Xs):
        """
        GP posterior prediction.

        Returns:
        - Predictive mean
        - Predictive standard deviation
        """
        lc, lk, ls,_ = self.theta

        # Cross-covariance between test and training points
        Kxs = self.kernel(Xs, self.X, np.exp(lc), np.exp(lk), np.exp(2*ls))

        # Posterior mean
        mu = Kxs @ self.alpha

        # Posterior variance
        v = cho_solve((self.L,True), Kxs.T)
        var = np.exp(2*ls) - np.sum(Kxs * v.T, axis=1)

        # De-normalise predictions
        return mu*self.s + self.m, np.sqrt(np.maximum(var,1e-12))*self.s


# -------------------------------------------------------------
# Expected Improvement (EI) acquisition function
# -------------------------------------------------------------
def expected_improvement(mu, sigma, best):
    """
    Computes Expected Improvement (EI).

    EI balances:
    - Exploitation: high predicted mean
    - Exploration: high predictive uncertainty
    """
    z = (mu - best) / (sigma + 1e-9)
    return (mu - best)*norm.cdf(z) + sigma*norm.pdf(z)


# -------------------------------------------------------------
# Bayesian Optimisation with Kriging Believer (batch BO)
# -------------------------------------------------------------
class BO:
    def __init__(self, X_init, X_pool, iters, batch):
        """
        Batch Bayesian Optimisation loop.

        Uses:
        - Expected Improvement
        - Kriging Believer to select batch points sequentially
        """
        # Variable bounds and categorical options
        self.bounds = {'temp':(30,40),'pH':(6,8),'f1':(0,50),'f2':(0,50),'f3':(0,50)}
        self.celltypes = ['celltype_1','celltype_2','celltype_3']

        # Candidate pool and encoded representation
        self.pool = X_pool
        self.enc_pool = self._encode_batch(X_pool)
        self.taken = np.zeros(len(X_pool), bool)

        # Store observed inputs and outputs
        self.X_obs = list(X_init)
        self.Y = list(objective_func(X_init))

        # Track best value per batch (for coursework marking)
        self.batch_best = []

        # Fit initial GP
        self.gp = GP()
        self.gp.fit(self._encode_batch(self.X_obs), np.array(self.Y))

        # Main BO loop (iterations = number of batches)
        for _ in range(iters):
            fake_X, fake_Y = [], []

            # Kriging Believer: sequentially fill batch
            for _ in range(batch):
                mu, std = self.gp.predict(self.enc_pool)
                best = max(self.Y + fake_Y)

                # Acquisition evaluation
                ei = expected_improvement(mu, std, best)

                # Select next candidate
                idx = np.argmax(ei)
                x_new = self.pool[idx]
                fake_X.append(x_new)

                # "Believe" GP mean as fake observation
                mu_fake,_ = self.gp.predict(self._encode_batch([x_new]))
                fake_Y.append(mu_fake[0])

                # Temporarily refit GP including fake data
                self.gp.fit(
                    self._encode_batch(self.X_obs + fake_X),
                    np.array(self.Y + fake_Y)
                )

            # Evaluate true objective for the batch
            Y_real = objective_func(fake_X)

            # Store batch-level best (used for scoring & plots)
            self.batch_best.append(float(np.max(Y_real)))

            # Update observation history
            self.X_obs.extend(fake_X)
            self.Y.extend(Y_real.tolist())

            # Refit GP with real observations
            self.gp.fit(self._encode_batch(self.X_obs), np.array(self.Y))


    def _encode_point(self,x):
        """
        Encode a single input:
        - Scale continuous variables to [0,1]
        - One-hot encode categorical cell type
        """
        t,pH,f1,f2,f3,ct=x
        cont=[(t-30)/10,(pH-6)/2,f1/50,f2/50,f3/50]
        cat=[1 if ct==c else 0 for c in self.celltypes]
        return np.array(cont+cat)

    def _encode_batch(self,X):
        """Encode a batch of inputs."""
        return np.vstack([self._encode_point(x) for x in X])


# -------------------------------------------------------------
# Initialisation (Sobol sampling)
# -------------------------------------------------------------
bounds = np.array([[30,40],[6,8],[0,50],[0,50],[0,50]])
celltypes = ['celltype_1','celltype_2','celltype_3']

def make_init(n=6):
    """
    Generate initial design using Sobol sequence.
    """
    X=[]
    for i in range(n):
        u,_=i4_sobol(5,i)
        c=bounds[:,0]+u*(bounds[:,1]-bounds[:,0])
        X.append([*c,celltypes[i%3]])
    return X

def make_pool(n=3000):
    """
    Generate candidate pool using Sobol sampling.
    """
    X=[]
    for i in range(n):
        u,_=i4_sobol(5,i+100)
        c=bounds[:,0]+u*(bounds[:,1]-bounds[:,0])
        X.append([*c,random.choice(celltypes)])
    return X


# -------------------------------------------------------------
# Run optimisation
# -------------------------------------------------------------
bo = BO(make_init(), make_pool(), iters=15, batch=5)


