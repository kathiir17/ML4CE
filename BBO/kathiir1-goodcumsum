# -------------------------------------------------------------
# Sobol initialisation and candidate pool
# -------------------------------------------------------------
bounds = np.array([[30, 40], [6, 8], [0, 50], [0, 50], [0, 50]])
celltypes = ["celltype_1", "celltype_2", "celltype_3"]


def make_init_with_offset(n=6, sobol_offset=0):
    X = []
    for i in range(n):
        u, _ = i4_sobol(5, sobol_offset + i)
        c = bounds[:, 0] + u * (bounds[:, 1] - bounds[:, 0])
        X.append([*c, celltypes[i % 3]])
    return X

def make_pool_balanced(n_total=3000, sobol_offset=100):
    """
    Balanced candidate pool:
    same number of Sobol continuous points per celltype
    no random.choice(celltypes)
    """
    per = n_total // 3
    X = []

    for ct_idx, ct in enumerate(celltypes):
        for j in range(per):
            # separate Sobol streams per celltype to avoid identical repeats
            u, _ = i4_sobol(5, sobol_offset + ct_idx * per + j)
            c = bounds[:, 0] + u * (bounds[:, 1] - bounds[:, 0])
            X.append([*c, ct])

    # if n_total not divisible by 3, fill remainder deterministically
    rem = n_total - 3 * per
    for r in range(rem):
        u, _ = i4_sobol(5, sobol_offset + 3 * per + r)
        c = bounds[:, 0] + u * (bounds[:, 1] - bounds[:, 0])
        X.append([*c, celltypes[r % 3]])

    return X

# -------------------------------------------------------------
# Run BO 15 times (MARK-SCHEME CORRECT CUMSUM)
# -------------------------------------------------------------
iters = 15
batch = 5
N_RUNS = 15

bo_best_runs = []
bo_cum_runs = []


for run_idx in range(N_RUNS):
    init_offset  = random.randint(0, 50_000)
    sobol_offset = init_offset + 10_000
    X_pool = make_pool_balanced(n_total=3000, sobol_offset=sobol_offset)
    X_init = make_init_with_offset(n=6, sobol_offset=init_offset)

    bo = BO(X_init, X_pool, iters, batch)

    bb = np.array(bo.batch_best, dtype=float)

    bo_best = float(bb.max())
    best_so_far = np.maximum.accumulate(bb)     # mark-scheme running-best
    bo_cum = float(best_so_far.sum())

    bo_best_runs.append(bo_best)
    bo_cum_runs.append(bo_cum)

    print(f"Run {run_idx+1:02d}/{N_RUNS} | BO best={bo_best:.3f} cum@15={bo_cum:.3f}")

bo_best_runs = np.array(bo_best_runs, dtype=float)
bo_cum_runs = np.array(bo_cum_runs, dtype=float)

print("\n=== 15-RUN SUMMARY ===")
print(f"BO avg best titre:     {bo_best_runs.mean():.3f} (std {bo_best_runs.std(ddof=1):.3f})")
print(f"BO avg cum titre @15:  {bo_cum_runs.mean():.3f} (std {bo_cum_runs.std(ddof=1):.3f})")
