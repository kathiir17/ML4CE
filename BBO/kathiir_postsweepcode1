# -------------------------------------------------------------
# Gaussian Process
# -------------------------------------------------------------
class GP:
    def __init__(self, n_restarts=3, restart_scale=0.35, seed=None):
        """
        n_restarts: number of extra ML-II starts (in addition to current theta)
        restart_scale: stddev of gaussian perturbation in log-space when restarting
        """
        self.theta = np.log([0.5, 0.5, 1.0, 1e-4])  # [log(lc), log(lk), log(ls), log(ln)]

        self._bounds = [
            (-3.0, 2.0),    # log(lc)
            (-3.0, 2.0),    # log(lk)
            (-3.0, 3.0),    # log(ls)
            (-15.0, -1.0),  # log(ln)
        ]

        self.n_restarts = int(n_restarts)
        self.restart_scale = float(restart_scale)
        self.rng = np.random.default_rng(seed)

    def kernel(self, A, B, lc, lk, s2):
        A1, A2 = A[:, :5]/lc, A[:, 5:]/lk
        B1, B2 = B[:, :5]/lc, B[:, 5:]/lk

        sq = np.sum(A1**2, 1)[:, None] + np.sum(B1**2, 1)[None, :] - 2*A1@B1.T
        sq += np.sum(A2**2, 1)[:, None] + np.sum(B2**2, 1)[None, :] - 2*A2@B2.T
        sq = np.maximum(sq, 0)

        d = np.sqrt(sq)
        sd = np.sqrt(5) * d
        return s2 * (1 + sd + 5*d*d/3) * np.exp(-sd)

    def _build_K(self, X, y_std):
        lc, lk, ls, ln = self.theta
        K = self.kernel(X, X, np.exp(lc), np.exp(lk), np.exp(2*ls))

        # jitter: small base + scale with y variance (in standardised space)
        jitter = 1e-8 + 1e-6*np.var(y_std)
        K[np.diag_indices(len(X))] += np.exp(2*ln) + jitter
        return K

    def neg_log_mll(self, theta):
        old = self.theta
        self.theta = theta
        try:
            K = self._build_K(self.X, self.y)
            L, _ = cho_factor(K, lower=True)
            alpha = cho_solve((L, True), self.y)
            nll = (
                0.5*self.y@alpha
                + np.sum(np.log(np.diag(L)))
                + 0.5*len(self.y)*np.log(2*np.pi)
            )
        except LinAlgError:
            nll = 1e25
        self.theta = old
        return nll

    def _clip_to_bounds(self, theta):
        out = np.array(theta, dtype=float).copy()
        for i, (lo, hi) in enumerate(self._bounds):
            out[i] = float(np.clip(out[i], lo, hi))
        return out

    def _optimise_theta_multistart(self):
        """
        ML-II with restarts: run L-BFGS-B from several initial thetas,
        keep the best (lowest NLL).
        """
        starts = [self.theta.copy()]

        # random jittered restarts in log-space
        for _ in range(self.n_restarts):
            th0 = self.theta + self.rng.normal(0.0, self.restart_scale, size=self.theta.shape)
            starts.append(self._clip_to_bounds(th0))

        best_nll = 1e30
        best_theta = self.theta.copy()

        for th0 in starts:
            try:
                res = minimize(
                    self.neg_log_mll,
                    th0,
                    method="L-BFGS-B",
                    bounds=self._bounds
                )
                th = res.x
                nll = float(res.fun) if np.isfinite(res.fun) else 1e25
            except Exception:
                th = th0
                nll = 1e25

            if nll < best_nll:
                best_nll = nll
                best_theta = th

        self.theta = best_theta

    def fit(self, X, y, optimise=True):
        self.X = X

        # standardise targets
        self.m = float(np.mean(y))
        self.s = float(np.std(y)) if float(np.std(y)) > 1e-9 else 1.0
        self.y = (y - self.m) / self.s

        if optimise:
            self._optimise_theta_multistart()

        # cache factorisation for prediction
        K = self._build_K(self.X, self.y)
        self.L, _ = cho_factor(K, lower=True)
        self.alpha = cho_solve((self.L, True), self.y)

    def predict(self, Xs):
        lc, lk, ls, _ = self.theta
        Kxs = self.kernel(Xs, self.X, np.exp(lc), np.exp(lk), np.exp(2*ls))
        mu = Kxs @ self.alpha
        v = cho_solve((self.L, True), Kxs.T)
        var = np.exp(2*ls) - np.sum(Kxs * v.T, axis=1)
        return mu*self.s + self.m, np.sqrt(np.maximum(var, 1e-12))*self.s


# -------------------------------------------------------------
# Expected Improvement
# -------------------------------------------------------------
def expected_improvement(mu, sigma, best, xi=0.01):
    z = (mu - best - xi) / (sigma + 1e-9)
    return (mu - best - xi) * norm.cdf(z) + sigma * norm.pdf(z)


# -------------------------------------------------------------
# xi schedule (BEST policy + floor)
# -------------------------------------------------------------
def xi_schedule(best_real):
    # Best from sweep: amplitude 0.24, decay 0.05, cap 0.30, floor 0.03
    return float(np.clip(0.24 * np.exp(-0.05 * best_real / 10.0), 0.03, 0.30))


# -------------------------------------------------------------
# Bayesian Optimisation
# -------------------------------------------------------------
class BO:
    def __init__(self, X_init, X_pool, iters, batch):

        # ---------- knobs (best policy + robustness) ----------
        self.N_MIN_OPT = 15            # warm-up threshold for ML-II
        self.UCB_KAPPA = 1.0           # best policy
        self.UCB_PICKS = 2             # best policy
        self.DIV_WEIGHT = 0.30         # base diversity weight
        self.DIV_WEIGHT_B1 = 0.50      # stronger only in batch 1
        self.TIE_TOPK = 5              # random among top-5 early to avoid deterministic collapse
        self.TIE_BATCHES = 1           # apply tie-breaking only in batch 1
        # ------------------------------------------------------

        self.celltypes = ['celltype_1', 'celltype_2', 'celltype_3']
        self.pool = X_pool
        self.enc_pool = self._encode_batch(X_pool)
        self.taken = np.zeros(len(X_pool), bool)

        self.X_obs = list(X_init)
        self.Y = list(objective_func(X_init))

        self.batch_best = []
        self.cum_time = []
        self.xi_values = []

        # GP with ML-II restarts for stability
        self.gp = GP(n_restarts=3, restart_scale=0.35)

        # initial real fit: no ML-II on tiny data
        self.gp.fit(
            self._encode_batch(self.X_obs),
            np.array(self.Y, dtype=float),
            optimise=False
        )

        start = time.time()

        for batch_num in range(1, iters + 1):
            fake_X, fake_Y = [], []

            best_real = float(np.max(self.Y))
            xi_val = xi_schedule(best_real)
            self.xi_values.append(xi_val)

            # stronger diversity only in batch 1
            div_w = self.DIV_WEIGHT_B1 if batch_num == 1 else self.DIV_WEIGHT

            for pick_idx in range(batch):
                mu, std = self.gp.predict(self.enc_pool)
                best_ref = float(np.max(self.Y + fake_Y))

                # UCB boost only for first 2 picks of batch 1 (inside EI)
                if (batch_num == 1) and (pick_idx < self.UCB_PICKS):
                    mu_eff = mu + self.UCB_KAPPA * std
                else:
                    mu_eff = mu

                score = expected_improvement(mu_eff, std, best_ref, xi=xi_val)

                # diversity penalty within current batch
                if len(fake_X) > 0:
                    enc_fake = self._encode_batch(fake_X)
                    diff = self.enc_pool[:, None, :] - enc_fake[None, :, :]
                    dist = np.linalg.norm(diff, axis=2).min(axis=1)
                    score = score * (1.0 + div_w * dist)

                score[self.taken] = -np.inf

                # tie-break early: random among top-K scores (batch 1 only)
                if batch_num <= self.TIE_BATCHES:
                    # handle case where many -inf (shouldn't happen early)
                    finite = np.isfinite(score)
                    if np.any(finite):
                        k = min(self.TIE_TOPK, int(np.sum(finite)))
                        cand = np.argpartition(score, -k)[-k:]
                        idx = int(np.random.choice(cand))
                    else:
                        idx = int(np.argmax(score))
                else:
                    idx = int(np.argmax(score))

                self.taken[idx] = True
                x_new = self.pool[idx]
                fake_X.append(x_new)

                # hallucinate
                mu_fake, _ = self.gp.predict(self._encode_batch([x_new]))
                fake_Y.append(float(mu_fake[0]))

                # posterior update only during batch (no ML-II)
                self.gp.fit(
                    self._encode_batch(self.X_obs + fake_X),
                    np.array(self.Y + fake_Y, dtype=float),
                    optimise=False
                )

            # evaluate batch for real
            Y_real = objective_func(fake_X)
            self.batch_best.append(float(np.max(Y_real)))
            self.cum_time.append(time.time() - start)

            self.X_obs.extend(fake_X)
            self.Y.extend(Y_real.tolist())

            # ML-II only after enough REAL points
            optimise_now = (len(self.Y) >= self.N_MIN_OPT)
            self.gp.fit(
                self._encode_batch(self.X_obs),
                np.array(self.Y, dtype=float),
                optimise=optimise_now
            )

    def _encode_point(self, x):
        t, pH, f1, f2, f3, ct = x
        cont = [(t-30)/10, (pH-6)/2, f1/50, f2/50, f3/50]
        cat = [1 if ct == c else 0 for c in self.celltypes]
        return np.array(cont + cat)

    def _encode_batch(self, X):
        return np.vstack([self._encode_point(x) for x in X])


# -------------------------------------------------------------
# Sobol initialisation and balanced pool
# -------------------------------------------------------------
bounds = np.array([[30, 40], [6, 8], [0, 50], [0, 50], [0, 50]])
celltypes = ["celltype_1", "celltype_2", "celltype_3"]

def make_init_with_offset(n=6, sobol_offset=0, sobol_stride=1):
    X = []
    for i in range(n):
        u, _ = i4_sobol(5, sobol_offset + sobol_stride * i)
        c = bounds[:, 0] + u * (bounds[:, 1] - bounds[:, 0])
        X.append([*c, celltypes[i % 3]])
    return X

def make_pool_balanced(n_total=3000, sobol_offset=100, sobol_stride=1):
    per = n_total // 3
    X = []
    for ct_idx, ct in enumerate(celltypes):
        for j in range(per):
            idx = ct_idx * per + j
            u, _ = i4_sobol(5, sobol_offset + sobol_stride * idx)
            c = bounds[:, 0] + u * (bounds[:, 1] - bounds[:, 0])
            X.append([*c, ct])

    rem = n_total - 3 * per
    for r in range(rem):
        idx = 3 * per + r
        u, _ = i4_sobol(5, sobol_offset + sobol_stride * idx)
        c = bounds[:, 0] + u * (bounds[:, 1] - bounds[:, 0])
        X.append([*c, celltypes[r % 3]])

    return X


# -------------------------------------------------------------
# Run BO N_RUNS=30
# -------------------------------------------------------------
iters = 15
batch = 5
N_RUNS = 30

bo_best_runs = []
bo_cum_runs = []

t0 = time.time()

for run_idx in range(N_RUNS):
    base = random.randint(0, 50_000)
    stride_pool = random.choice([1, 3, 5, 7, 9])
    stride_init = random.choice([1, 3, 5, 7, 9])

    X_pool = make_pool_balanced(n_total=3000, sobol_offset=base + 10_000, sobol_stride=stride_pool)
    X_init = make_init_with_offset(n=6, sobol_offset=base, sobol_stride=stride_init)

    bo = BO(X_init, X_pool, iters, batch)

    bb = np.array(bo.batch_best, dtype=float)
    bo_best = float(bb.max())
    bo_cum = float(np.maximum.accumulate(bb).sum())

    bo_best_runs.append(bo_best)
    bo_cum_runs.append(bo_cum)

    print(f"Run {run_idx+1:02d}/{N_RUNS} | BO best={bo_best:.3f} cum@15={bo_cum:.3f}")

bo_best_runs = np.array(bo_best_runs, dtype=float)
bo_cum_runs = np.array(bo_cum_runs, dtype=float)

print("\n=== 30-RUN SUMMARY ===")
print(f"BO avg best titre:     {bo_best_runs.mean():.3f} (std {bo_best_runs.std(ddof=1):.3f})")
print(f"BO avg cum titre @15:  {bo_cum_runs.mean():.3f} (std {bo_cum_runs.std(ddof=1):.3f})")
print(f"Total runtime: {time.time() - t0:.1f}s")

