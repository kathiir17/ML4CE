def build_pool_and_init(base: int, variant: Variant, bank: EliteBank) -> Tuple[List[List[Any]], List[List[Any]]]:
    stride_pool = random.choice([1, 3, 5, 7, 9])
    stride_init = random.choice([1, 3, 5, 7, 9])
    init_offset = base
    pool_offset = base + 10_000

    X_pool = make_pool_balanced(n_total=variant.pool_size, sobol_offset=pool_offset, sobol_stride=stride_pool)
    X_init = make_init_with_offset(n=N_INIT, sobol_offset=init_offset, sobol_stride=stride_init)

    if bank.has_any() and variant.use_elite_bank_in_pool:
        injected: List[List[Any]] = []
        for ct in celltypes:
            top_pts = bank.top(ct, variant.elite_bank_pool_points_per_ct)
            injected.extend([list(p) for p in top_pts])

            n_jitter = max(0, variant.elite_bank_pool_points_per_ct // 3)
            for p in top_pts[:n_jitter]:
                t, pH, f1, f2, f3, ct0 = p
                span = bounds[:, 1] - bounds[:, 0]
                r = 0.04 * span
                for _ in range(2):
                    q = clip_x([
                        t + random.uniform(-r[0], r[0]),
                        pH + random.uniform(-r[1], r[1]),
                        f1 + random.uniform(-r[2], r[2]),
                        f2 + random.uniform(-r[3], r[3]),
                        f3 + random.uniform(-r[4], r[4]),
                        ct0
                    ])
                    injected.append(q)

        if len(injected) > 0:
            X_pool = (injected + X_pool)[:variant.pool_size]

    if bank.has_any() and variant.use_elite_bank_in_init:
        init_inj: List[List[Any]] = []
        per_ct = max(1, variant.elite_bank_init_points // 3)
        for ct in celltypes:
            init_inj.extend(bank.top(ct, per_ct))
        init_inj = init_inj[:variant.elite_bank_init_points]
        X_init = (init_inj + X_init)[:N_INIT]

    return X_pool, X_init


def make_report(runs_df: pd.DataFrame, eval_df: pd.DataFrame):
    path = os.path.join(OUT_DIR, "report.txt")
    ok = runs_df[runs_df["status"] == "ok"].copy()
    lines: List[str] = []

    if len(ok) == 0:
        with open(path, "w", encoding="utf8") as f:
            f.write("No successful runs\n")
        return

    lines.append("Summary by variant\n")
    grp = (
        ok.groupby("variant", as_index=False)
          .agg(
              n=("run_id", "count"),
              avg_best=("best", "mean"),
              std_best=("best", "std"),
              avg_cum15=("cum15", "mean"),
              std_cum15=("cum15", "std"),
              avg_first330=("first_hit_330_eval",
                           lambda s: float(np.mean([v for v in s.values if v >= 0]))
                           if np.any(s.values >= 0) else -1.0),
              hit_rate_330=("first_hit_330_eval",
                            lambda s: float(np.mean([1.0 if v >= 0 else 0.0 for v in s.values]))),
          )
          .sort_values("avg_best", ascending=False)
    )
    lines.append(grp.to_string(index=False))
    lines.append("\n")

    overall_best = float(ok["best"].mean())
    overall_cum = float(ok["cum15"].mean())
    lines.append("Overall\n")
    lines.append(f"runs {len(ok)}\n")
    lines.append(f"avg_best {overall_best:.3f}\n")
    lines.append(f"avg_cum15 {overall_cum:.3f}\n")
    lines.append("\n")

    lines.append("Early vs late elite discovery\n")
