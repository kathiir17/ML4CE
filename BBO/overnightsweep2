            f"avg_cum15={float(ok.loc[mask, 'cum15'].mean()):.2f}\n"
        )

    lines.append(summarize_subset("early_hit_330", early_mask))
    lines.append(summarize_subset("late_hit_330", late_mask))
    lines.append(summarize_subset("no_hit_330", none_mask))
    lines.append("\n")

    feat_cols = [c for c in ok.columns if c.startswith("early_")]
    if len(feat_cols) > 0:
        corr_best = ok[feat_cols + ["best"]].corr(numeric_only=True)["best"].drop("best").sort_values(ascending=False)
        corr_cum = ok[feat_cols + ["cum15"]].corr(numeric_only=True)["cum15"].drop("cum15").sort_values(ascending=False)
        lines.append("Top correlations with best\n")
        lines.append(corr_best.head(15).to_string())
        lines.append("\n")
        lines.append("Top correlations with cum15\n")
        lines.append(corr_cum.head(15).to_string())
        lines.append("\n")

    top_variant = str(grp.iloc[0]["variant"])
    lines.append("Actionable next steps\n")
    lines.append(f"1 Set default to top variant from this overnight run: {top_variant}\n")

    probe_rows = grp[grp["variant"].str.contains("probe", na=False)]
    if len(probe_rows) > 0:
        lines.append("2 If local_probe variants rank near the top, keep it permanently and increase probe points from 2 to 3\n")
        lines.append("   Rationale converts one off spikes into sustained batch best improvements, raising cum15\n")

    rep_rows = grp[grp["variant"].str.contains("replicate", na=False)]
    if len(rep_rows) > 0:
        lines.append("3 If replicate_plus_probe improves avg_best but hurts cum15, keep replication only above a higher threshold like 395\n")
        lines.append("   Rationale avoid wasting evaluations replicating mediocre points\n")

    cov_rows = grp[grp["variant"].str.contains("coverage", na=False)]
    if len(cov_rows) > 0:
        lines.append("4 If coverage variants increase hit_rate_330 and reduce early_lowcount, keep coverage for batch 1 only\n")
        lines.append("   Rationale coverage is mainly about avoiding early collapse runs\n")

    big_pool_rows = grp[grp["variant"].str.contains("6000", na=False)]
    if len(big_pool_rows) > 0:
        lines.append("5 If bigger_pool improves avg_best, keep pool_size 6000 but cap candidate evaluation overhead by caching enc_pool\n")

    lines.append("6 Regardless of variant, keep elite bank injection in pool\n")
    lines.append("   Rationale you already observed feasible 400+ outcomes, so reusing elite structure should lift averages fast\n")
    lines.append("\n")

    with open(path, "w", encoding="utf8") as f:
        f.write("".join(lines))


def make_plots(runs_df: pd.DataFrame, eval_df: pd.DataFrame):
    ok = runs_df[runs_df["status"] == "ok"].copy()
    if len(ok) == 0:
        return

    plt.figure()
    ok.boxplot(column="best", by="variant", rot=45)
    plt.suptitle("")
    plt.title("best by variant")
    plt.tight_layout()
    plt.savefig(os.path.join(PLOT_DIR, "box_best.png"), dpi=180)
    plt.close()

    plt.figure()
    ok.boxplot(column="cum15", by="variant", rot=45)
    plt.suptitle("")
    plt.title("cum15 by variant")
    plt.tight_layout()
    plt.savefig(os.path.join(PLOT_DIR, "box_cum15.png"), dpi=180)
    plt.close()

    plt.figure()
    plt.scatter(ok["best"], ok["cum15"])
    plt.xlabel("best")
    plt.ylabel("cum15")
    plt.tight_layout()
    plt.savefig(os.path.join(PLOT_DIR, "scatter_best_vs_cum15.png"), dpi=180)
    plt.close()

    curves = []
    for (variant, run_id), sub in eval_df.groupby(["variant", "run_id"]):
        sub2 = sub.sort_values("eval_index")
        y = sub2["y"].to_numpy(dtype=float)
        rb = np.maximum.accumulate(y)
        for i in range(len(rb)):
            curves.append({
                "variant": variant,
                "eval_index": int(sub2.iloc[i]["eval_index"]),
                "rb": float(rb[i])
            })
    curves_df = pd.DataFrame(curves)

    plt.figure()
    for variant, sub in curves_df.groupby("variant"):
        m = sub.groupby("eval_index")["rb"].mean()
        plt.plot(m.index.to_numpy(dtype=int), m.to_numpy(dtype=float), label=str(variant))
    plt.xlabel("eval_index")
    plt.ylabel("mean running best")
    plt.legend()
    plt.tight_layout()
    plt.savefig(os.path.join(PLOT_DIR, "mean_running_best_by_variant.png"), dpi=180)
    plt.close()


def main():
    meta = {
        "started": time.strftime("%Y%m%d_%H%M%S"),
        "wall_clock_hours": WALL_CLOCK_HOURS,
        "evals_per_run": EVALS_PER_RUN,
        "iters": ITERS,
        "batch": BATCH,
        "variants": [asdict(v) for v in VARIANTS],
    }
    with open(os.path.join(OUT_DIR, "meta.json"), "w", encoding="utf8") as f:
        json.dump(meta, f, indent=2)

    bank = EliteBank(max_points_per_ct=250)

    run_rows: List[Dict[str, Any]] = []
    eval_rows: List[Dict[str, Any]] = []

    start = time.time()
    deadline = start + WALL_CLOCK_SECONDS

    run_id = 0
    vidx = 0

    while time.time() < deadline:
        run_id += 1
        variant = VARIANTS[vidx]
        vidx = (vidx + 1) % len(VARIANTS)

        base = random.randint(0, 50_000)
        X_pool, X_init = build_pool_and_init(base, variant, bank)

        t0 = time.time()
        try:
            bo = BO(X_init, X_pool, ITERS, BATCH, variant)
        except Exception as e:
            run_rows.append({
                "run_id": run_id,
                "variant": variant.name,
                "status": "error",
                "error": repr(e),
                "runtime_s": time.time() - t0,
                "base": base,
            })
            continue

        bb = np.array(bo.batch_best, dtype=float)
        best = float(np.max(bb))
        cum15 = cum15_from_batch_best(bb)

        eval_df_run = pd.DataFrame(bo.eval_log)
        y_all = eval_df_run["y"].to_numpy(dtype=float)
        first330 = eval_index_of_first_hit(y_all, ELITE_THR)

        feats: Dict[str, float] = {}
        for k in EARLY_K:
            if len(eval_df_run) >= k:
                feats.update(early_features(eval_df_run, k))

        run_rows.append({
            "run_id": run_id,
            "variant": variant.name,
            "status": "ok",
            "runtime_s": time.time() - t0,
            "base": base,
            "best": best,
            "cum15": cum15,
            "first_hit_330_eval": first330,
            **feats,
        })

        for row in bo.eval_log:
            row2 = dict(row)
            row2["run_id"] = run_id
            row2["variant"] = variant.name
            row2["base"] = base
            eval_rows.append(row2)

        top_idx = np.argsort(-y_all)[:10]
        for i in top_idx:
            r = eval_df_run.iloc[int(i)]
            x = [
                float(r["t"]),
                float(r["pH"]),
                float(r["f1"]),
                float(r["f2"]),
                float(r["f3"]),
                str(r["celltype"])
            ]
            bank.add(x, float(r["y"]))

        if run_id % 5 == 0:
            pd.DataFrame(run_rows).to_csv(os.path.join(OUT_DIR, "runs_log.csv"), index=False)
            pd.DataFrame(eval_rows).to_csv(os.path.join(OUT_DIR, "eval_log.csv"), index=False)

        ok = [r for r in run_rows if r.get("status") == "ok"]
        if len(ok) > 0:
            avg_best = float(np.mean([r["best"] for r in ok]))
            avg_cum = float(np.mean([r["cum15"] for r in ok]))
            print(
                f"Run {run_id:03d} {variant.name} | best={best:.2f} cum15={cum15:.2f} "
                f"| avg_best={avg_best:.2f} avg_cum15={avg_cum:.2f}"
            )

    runs_df = pd.DataFrame(run_rows)
    eval_df_all = pd.DataFrame(eval_rows)

    runs_df.to_csv(os.path.join(OUT_DIR, "runs_log.csv"), index=False)
    eval_df_all.to_csv(os.path.join(OUT_DIR, "eval_log.csv"), index=False)

    make_report(runs_df, eval_df_all)
    make_plots(runs_df, eval_df_all)


if __name__ == "__main__":
    main()
