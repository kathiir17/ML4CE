class EliteBank:
    def __init__(self, max_points_per_ct=200):
        self.max_points_per_ct = max_points_per_ct
        self.store: Dict[str, List[Tuple[float, List[Any]]]] = {ct: [] for ct in celltypes}

    def add(self, x: List[Any], y: float):
        ct = x[-1]
        if ct not in self.store:
            return
        self.store[ct].append((float(y), list(x)))
        self.store[ct].sort(key=lambda t: t[0], reverse=True)
        self.store[ct] = self.store[ct][:self.max_points_per_ct]

    def top(self, ct: str, n: int) -> List[List[Any]]:
        if ct not in self.store:
            return []
        return [p for _, p in self.store[ct][:n]]

    def has_any(self) -> bool:
        return any(len(v) > 0 for v in self.store.values())


class BO:
    def __init__(self, X_init, X_pool, iters, batch, variant: Variant):
        self.variant = variant

        self.N_MIN_OPT = variant.N_MIN_OPT
        self.UCB_KAPPA = variant.UCB_KAPPA
        self.UCB_PICKS = variant.UCB_PICKS
        self.DIV_WEIGHT = variant.DIV_WEIGHT

        self.pool = X_pool
        self.enc_pool = encode_batch(X_pool)
        self.taken = np.zeros(len(X_pool), bool)

        self.X_obs = list(X_init)
        self.Y = list(objective_func(X_init))

        self.batch_best: List[float] = []
        self.xi_values: List[float] = []
        self.eval_log: List[Dict[str, Any]] = []

        for i, x in enumerate(self.X_obs):
            self.eval_log.append({
                "eval_index": i,
                "phase": "init",
                "t": float(x[0]),
                "pH": float(x[1]),
                "f1": float(x[2]),
                "f2": float(x[3]),
                "f3": float(x[4]),
                "celltype": str(x[5]),
                "y": float(self.Y[i]),
                "is_local_probe": 0,
                "is_replicate": 0,
            })

        self.gp = GP()
        self.gp.fit(encode_batch(self.X_obs), np.array(self.Y, dtype=float), optimise=False)

        eval_index = len(self.X_obs)
        current_best_x: Optional[List[Any]] = None
        current_best_y = float(np.max(self.Y))

        for batch_num in range(1, iters + 1):
            fake_X: List[List[Any]] = []
            fake_Y: List[float] = []
            fake_flags: List[Tuple[int, int]] = []
            local_probe_used = 0
            replicate_used = 0

            best_real = float(np.max(self.Y))

            if variant.xi_mode == "best_real":
                xi_val = float(np.clip(0.2 * np.exp(-0.05 * best_real / 10.0), 0.01, 0.3))
            elif variant.xi_mode == "constant":
                xi_val = float(variant.xi_constant)
            elif variant.xi_mode == "decay":
                frac = (batch_num - 1) / max(1, iters - 1)
                xi_val = float(variant.xi_decay_start * (1.0 - frac) + variant.xi_decay_final * frac)
            else:
                xi_val = 0.02

            self.xi_values.append(xi_val)

            for pick_idx in range(batch):
                use_local_probe = False
                use_replicate = False

                if variant.replicate_elite and (current_best_x is not None) and (current_best_y >= variant.replicate_threshold):
                    if replicate_used < variant.replicate_points and pick_idx == 0:
                        use_replicate = True

                if (not use_replicate) and variant.local_probe and (current_best_x is not None):
                    if local_probe_used < variant.local_probe_points:
                        use_local_probe = True

                if use_replicate:
                    x_new = list(current_best_x)
                    replicate_used += 1
                    pick_is_rep = 1
                    pick_is_lp = 0

                elif use_local_probe:
                    x_new = self._sample_near(current_best_x, variant.local_probe_radius_frac, prefer_ct=None)
                    local_probe_used += 1
                    pick_is_rep = 0
                    pick_is_lp = 1

                else:
                    mu, std = self.gp.predict(self.enc_pool)
                    best = float(np.max(self.Y + fake_Y))

                    if (batch_num == 1) and (pick_idx < self.UCB_PICKS):
                        mu_eff = mu + self.UCB_KAPPA * std
                    else:
                        mu_eff = mu

                    ei = expected_improvement(mu_eff, std, best, xi=xi_val)

                    if len(fake_X) > 0:
                        enc_fake = encode_batch(fake_X)
                        diff = self.enc_pool[:, None, :] - enc_fake[None, :, :]
                        dist = np.linalg.norm(diff, axis=2).min(axis=1)
                        ei = ei * (1.0 + self.DIV_WEIGHT * dist)

                    ei[self.taken] = -np.inf

                    if variant.force_celltype_coverage_iters > 0 and batch_num <= variant.force_celltype_coverage_iters:
                        missing = set(celltypes) - set([x[-1] for x in fake_X])
                        if len(missing) > 0 and pick_idx < 3:
                            allowed = np.array(
                                [True if self.pool[i][-1] in missing else False for i in range(len(self.pool))],
                                dtype=bool
                            )
                            ei[~allowed] = -np.inf

                    idx = int(np.argmax(ei))
                    self.taken[idx] = True
                    x_new = list(self.pool[idx])
                    pick_is_rep = 0
                    pick_is_lp = 0

                fake_X.append(x_new)
                fake_flags.append((pick_is_lp, pick_is_rep))

                mu_fake, _ = self.gp.predict(encode_batch([x_new]))
                fake_Y.append(float(mu_fake[0]))

                self.gp.fit(
                    encode_batch(self.X_obs + fake_X),
                    np.array(self.Y + fake_Y, dtype=float),
                    optimise=False
                )

            Y_real = objective_func(fake_X)

            self.batch_best.append(float(np.max(Y_real)))
            self.X_obs.extend(fake_X)
            self.Y.extend(Y_real.tolist())

            for j, x in enumerate(fake_X):
                yj = float(Y_real[j])
                is_lp, is_rep = fake_flags[j]
                self.eval_log.append({
                    "eval_index": eval_index,
                    "phase": f"batch_{batch_num}",
                    "t": float(x[0]),
                    "pH": float(x[1]),
                    "f1": float(x[2]),
                    "f2": float(x[3]),
                    "f3": float(x[4]),
                    "celltype": str(x[5]),
                    "y": yj,
                    "is_local_probe": int(is_lp),
                    "is_replicate": int(is_rep),
                })
                eval_index += 1

            new_best_y = float(np.max(self.Y))
            if new_best_y > current_best_y:
                current_best_y = new_best_y
                best_idx = int(np.argmax(np.array(self.Y, dtype=float)))
                current_best_x = list(self.X_obs[best_idx])

            optimise_now = (len(self.Y) >= self.N_MIN_OPT)
            self.gp.fit(encode_batch(self.X_obs), np.array(self.Y, dtype=float), optimise=optimise_now)

    def _sample_near(self, x_center: List[Any], radius_frac: float, prefer_ct: Optional[str]) -> List[Any]:
        t, pH, f1, f2, f3, ct = x_center
        span = bounds[:, 1] - bounds[:, 0]
        r = radius_frac * span
        t2 = t + random.uniform(-r[0], r[0])
        pH2 = pH + random.uniform(-r[1], r[1])
        f12 = f1 + random.uniform(-r[2], r[2])
        f22 = f2 + random.uniform(-r[3], r[3])
        f32 = f3 + random.uniform(-r[4], r[4])
        ct2 = prefer_ct if prefer_ct in celltypes else ct
        return clip_x([t2, pH2, f12, f22, f32, ct2])


def running_best_from_batch_best(bb: np.ndarray) -> np.ndarray:
    out = np.empty_like(bb, dtype=float)
    best = -1e18
    for i, v in enumerate(bb):
        if v > best:
            best = v
        out[i] = best
    return out


def cum15_from_batch_best(bb: np.ndarray) -> float:
    rb = running_best_from_batch_best(bb)
    return float(np.sum(rb))


def eval_index_of_first_hit(y: np.ndarray, thr: float) -> int:
    idx = np.where(y >= thr)[0]
    return int(idx[0]) if len(idx) else -1


def early_features(eval_df: pd.DataFrame, k: int) -> Dict[str, float]:
    sub = eval_df.iloc[:k].copy()
    y = sub["y"].to_numpy(dtype=float)
    feats: Dict[str, float] = {}
    feats[f"early_best_{k}"] = float(np.nanmax(y))
    feats[f"early_mean_{k}"] = float(np.nanmean(y))
    feats[f"early_lowcount_{k}"] = float(np.sum(y <= 2.0))
    ct_counts = sub["celltype"].value_counts(normalize=True)
    for ct in celltypes:
        feats[f"early_frac_{ct}_{k}"] = float(ct_counts.get(ct, 0.0))
    feats[f"early_unique_ct_{k}"] = float(sub["celltype"].nunique())
    X = sub[["t", "pH", "f1", "f2", "f3"]].to_numpy(dtype=float)
    step = np.linalg.norm(np.diff(X, axis=0), axis=1)
    feats[f"early_step_mean_{k}"] = float(np.mean(step)) if len(step) else 0.0
    return feats


