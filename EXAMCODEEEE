def biased_init_points(n=6):
    n = 6
    X = []

    base = random.randint(0, 300000)
    stride = random.choice([1, 3, 5, 7, 9, 11])
    for i in range(4):
        u, _ = sobol_seq.i4_sobol(5, base + stride * i)
        c = BOUNDS[:, 0] + u * (BOUNDS[:, 1] - BOUNDS[:, 0])
        X.append([float(c[0]), float(c[1]), float(c[2]), float(c[3]), float(c[4]), "celltype_1"])

    sub_lo = np.array([32.5, 6.10, 22.0, 22.0, 22.0], dtype=float)
    sub_hi = np.array([37.5, 6.70, 46.0, 46.0, 46.0], dtype=float)

    z1 = sub_lo + np.random.rand(5) * (sub_hi - sub_lo)
    z2 = sub_lo + np.random.rand(5) * (sub_hi - sub_lo)

    z1[2:] = np.maximum(z1[2:], 32.0)
    z2[2:] = np.maximum(z2[2:], 30.0)

    for z in (z1, z2):
        z = np.clip(z, BOUNDS[:, 0], BOUNDS[:, 1])
        X.append([float(z[0]), float(z[1]), float(z[2]), float(z[3]), float(z[4]), "celltype_1"])

    cts = ["celltype_1", "celltype_2", "celltype_3",
           "celltype_1", "celltype_2", "celltype_3"]
    for i in range(6):
        X[i][-1] = cts[i]

    return X
```

