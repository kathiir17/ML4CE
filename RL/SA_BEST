import copy
import time
import numpy as np
import torch
from tqdm import tqdm

from common import PolicyNetwork
from ML4CE_RL_environment import MESCEnv
from utils import setup_model_saving


def your_optimization_alg(
    env: MESCEnv,
    policy_net: PolicyNetwork,
    *,
    max_episodes=2000,
    max_time=5 * 60,  # seconds
):
    # Create file to store model weights
    save_f_path = setup_model_saving(algorithm="Your algorithm")

    # Buffers for plotting
    plot_data = {"reward_history": [], "episodes": []}

    # Book-keeping
    start_time = time.time()
    best_reward = -np.inf
    best_policy = copy.deepcopy(policy_net.state_dict())

    # -----------------------------------------------------------------------------------
    # PLEASE DO NOT MODIFY THE CODE ABOVE THIS LINE
    # -----------------------------------------------------------------------------------

    # =========================
    # Training loop
    # =========================
    for episode in tqdm(range(int(max_episodes)), desc="Episode loop"):

            # =========================
        # Simulated Annealing setup
        # =========================
        if episode == 0:
            # SA hyperparameters
            T = 1.0            # initial temperature
            T_min = 1e-3       # minimum temperature
            alpha = 0.995      # cooling rate
            noise_std = 0.05   # parameter perturbation scale
            

            # Helper functions (defined once)
            def get_flat_params(model):
                return torch.cat([p.data.view(-1) for p in model.parameters()])

            def set_flat_params(model, flat_params):
                idx = 0
                for p in model.parameters():
                    numel = p.numel()
                    p.data.copy_(flat_params[idx:idx + numel].view_as(p))
                    idx += numel

            def evaluate_episode(env, policy_net):
                env.reset()
                state = env.state
                done = False
                total_reward = 0.0

                while not done:
                    state_t = torch.FloatTensor(state)
                    action_mean = policy_net(state_t)

                    action_np = np.clip(
                        np.round(action_mean.detach().numpy()),
                        env.action_space.low,
                        env.action_space.high,
                    ).astype(np.int16)

                    state, reward, done, _ = env.step(action_np)
                    total_reward += reward

                return total_reward

            # Initial evaluation
            current_params = get_flat_params(policy_net)
            current_reward = evaluate_episode(env, policy_net)

            best_reward = current_reward
            best_policy = copy.deepcopy(policy_net.state_dict())
            torch.save(best_policy, save_f_path)
            
            no_improve_counter = 0

        # =========================
        # Propose new parameters
        # =========================
        adaptive_noise = noise_std * (T / 1.0)
        proposal_params = current_params + adaptive_noise * torch.randn_like(current_params)
        set_flat_params(policy_net, proposal_params)

        def evaluate_K(env, policy_net, K=3):
            return np.mean([evaluate_episode(env, policy_net) for _ in range(K)])

        proposal_reward = evaluate_K(env, policy_net, K=3)

        delta = proposal_reward - current_reward

        # =========================
        # Acceptance rule
        # =========================
        if delta > 0 or np.random.rand() < np.exp(delta / T):
            current_params = proposal_params
            current_reward = proposal_reward
        else:
            set_flat_params(policy_net, current_params)

        # =========================
        # Cooling schedule
        # =========================
        T = max(T * alpha, T_min)

        # =========================
        # Logging & saving
        # =========================
        plot_data["episodes"].append(episode)
        plot_data["reward_history"].append(current_reward)

        if current_reward > best_reward:
            best_reward = current_reward
            best_policy = copy.deepcopy(policy_net.state_dict())
            torch.save(best_policy, save_f_path)
            no_improve_counter = 0
        else:
            no_improve_counter += 1
        
                # =========================
        # Reheating if stuck
        # =========================
        if no_improve_counter > 500:
            T = min(T * 1.5, 1.0)
            no_improve_counter = 0



        # -----------------------------------------------------------------------------------
        # PLEASE DO NOT MODIFY THE CODE BELOW THIS LINE
        # -----------------------------------------------------------------------------------
        if (time.time() - start_time) > max_time:
            break

    print(f"Policy model weights saved in: {save_f_path}")
    print(f"Best reward: {best_reward}")

    team_names = [
        "Del Rio Chanona, Antonio",
        "Fons, Isabela",
    ]
    cids = ["16879875", "06069513"]
    question = [1, 0]

    return best_policy, plot_data
