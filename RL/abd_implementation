import copy
import time

import numpy as np
import torch
import tqdm
from tqdm import tqdm

from common import PolicyNetwork
from ML4CE_RL_environment import MESCEnv
from utils import setup_model_saving


def your_optimization_alg(
    env: MESCEnv,
    policy_net: PolicyNetwork,
    *,
    max_episodes=2000,
    max_time=5 * 60,  # seconds
):
    # Create file to store model weigths
    save_f_path = setup_model_saving(algorithm="Your algorithm")

    # Initialize buffers to store data for plotting
    plot_data = {"reward_history": [], "episodes": []}

    start_time = time.time()
    best_reward = -np.inf
    best_policy = policy_net.state_dict()
    # -----------------------------------------------------------------------------------
    # PLEASE DO NOT MODIFY THE CODE ABOVE THIS LINE
    # -----------------------------------------------------------------------------------
    optimizer = torch.optim.Adam(policy_net.parameters(), lr=1e-3)
    gamma = 0.99
    action_std = torch.ones(env.n_actions)
    baseline = 0.0

    for episode in tqdm(range(int(max_episodes))):

        env.reset()
        state = env.state
        done = False

        log_probs = []
        rewards = []

        while not done:
            state_t = torch.FloatTensor(state)
            action_mean = policy_net(state_t)

            dist = torch.distributions.Normal(action_mean, action_std)
            action = dist.sample()
            log_prob = dist.log_prob(action).sum()

            action_np = np.clip(
                np.round(action.detach().numpy()),
                env.action_space.low,
                env.action_space.high,
            ).astype(np.int16)

            next_state, reward, done, _ = env.step(action_np)

            log_probs.append(log_prob)
            rewards.append(reward)
            state = next_state

        # Discounted return
        G = 0.0
        returns = []
        for r in reversed(rewards):
            G = r + gamma * G
            returns.insert(0, G)

        returns = torch.tensor(returns, dtype=torch.float32)
        episode_return = returns[0].item()

        # Baseline update
        baseline = 0.9 * baseline + 0.1 * episode_return
        advantages = returns - baseline

        # Policy update
        loss = -torch.sum(torch.stack(log_probs) * advantages)
        optimizer.zero_grad()
        loss.backward()
        optimizer.step()

        # 🔴 THIS IS CRITICAL
        plot_data["episodes"].append(episode)
        plot_data["reward_history"].append(episode_return)

        if episode_return > best_reward:
            best_reward = episode_return
            best_policy = copy.deepcopy(policy_net.state_dict())
            torch.save(best_policy, save_f_path)

        if (time.time() - start_time) > max_time:
            print("Timeout reached: the best policy found so far will be returned.")
            break

        # -----------------------------------------------------------------------------------
        # PLEASE DO NOT MODIFY THE CODE BELOW THIS LINE
        # -----------------------------------------------------------------------------------
        # Check time
        if (time.time() - start_time) > max_time:
            print("Timeout reached: the best policy found so far will be returned.")
            break

    print(f"Policy model weights saved in: {save_f_path}")
    print(f"Best reward: {best_reward}")

    # Names of the team members (Imperial format)
