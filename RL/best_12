import copy
import time
import numpy as np
import torch
from tqdm import tqdm
from collections import deque

from common import PolicyNetwork
from ML4CE_RL_environment import MESCEnv
from utils import setup_model_saving


def your_optimization_alg(
    env: MESCEnv,
    policy_net: PolicyNetwork,
    *,
    max_episodes=2000,
    max_time=5 * 60,  # seconds
):
    # Create file to store model weights
    save_f_path = setup_model_saving(algorithm="Your algorithm")

    # Buffers for plotting
    plot_data = {"reward_history": [], "episodes": []}

    # Book-keeping
    start_time = time.time()
    best_reward = -np.inf
    best_policy = copy.deepcopy(policy_net.state_dict())

    # -----------------------------------------------------------------------------------
    # PLEASE DO NOT MODIFY THE CODE ABOVE THIS LINE
    # -----------------------------------------------------------------------------------

    # =========================
    # Helper functions
    # =========================
    def run_episode(env, policy_net, demand=None):
        env.demand_dataset = demand
        env.reset()
        state = env.state
        done = False
        total_reward = 0.0
        trajectory = []

        while not done:
            with torch.no_grad():
                action_mean = policy_net(torch.FloatTensor(state))

            action = np.fix(action_mean.detach().numpy()).astype(np.int16)
            
            # Penalty for infeasible actions
            if np.any(action < env.action_space.low) or np.any(action > env.action_space.high):
                return -1e9, []

            next_state, reward, done, _ = env.step(action)
            trajectory.append((state, action, reward))
            state = next_state
            total_reward += reward

        return float(total_reward), trajectory

    def evaluate_on_demands(env, policy_net, demands):
        rewards = []
        for d in demands:
            rew, _ = run_episode(env, policy_net, demand=d)
            rewards.append(rew)
        return np.mean(rewards)

    def evaluate(env, policy_net, K, demand_pool):
        idx = np.random.randint(0, len(demand_pool), size=K)
        batch = [demand_pool[i] for i in idx]
        return evaluate_on_demands(env, policy_net, batch)

    def get_flat_params(model):
        return torch.cat([p.data.view(-1) for p in model.parameters()])

    def set_flat_params(model, flat):
        idx = 0
        for p in model.parameters():
            n = p.numel()
            p.data.copy_(flat[idx:idx+n].view_as(p))
            idx += n

    # =========================
    # Behavioral Cloning - Initialize from heuristic (from slides)
    # =========================
    def heuristic_policy(state):
        """Simple (s,S) heuristic for initialization"""
        # Inventory positions: [retailer1, retailer2, DC, day_of_week]
        actions = np.zeros(3)
        
        # Retailers: reorder if below threshold
        for i in range(2):
            if state[i] < 20:  # s threshold
                actions[i] = min(40 - state[i], 50)  # S level
        
        # DC: reorder if below threshold
        if state[2] < 40:
            actions[2] = min(80 - state[2], 200)
        
        return actions

    # Collect heuristic data for warm start
    bc_samples = 50
    bc_data_x = []
    bc_data_y = []
    
    for _ in range(bc_samples):
        env.reset()
        state = env.state
        done = False
        while not done:
            action = heuristic_policy(state)
            bc_data_x.append(state)
            bc_data_y.append(action)
            state, _, done, _ = env.step(action.astype(np.int16))
    
    # Train policy network on heuristic data (behavioral cloning)
    if len(bc_data_x) > 0:
        X = torch.FloatTensor(np.array(bc_data_x))
        Y = torch.FloatTensor(np.array(bc_data_y))
        
        optimizer_bc = torch.optim.Adam(policy_net.parameters(), lr=0.01)
        for _ in range(100):
            pred = policy_net(X)
            loss = torch.nn.functional.mse_loss(pred, Y)
            optimizer_bc.zero_grad()
            loss.backward()
            optimizer_bc.step()

    # =========================
    # Hybrid SA + Gradient Information
    # =========================
    T = 2.2
    T_min = 5e-4
    alpha = 0.9987
    
    base_noise = 0.09
    noise = base_noise
    
    K_fast = 2
    K_slow = 6
    
    stagnation_limit = 200
    jump_every = 35
    
    # =========================
    # Diverse demand pool with strategic refresh
    # =========================
    pool_size = 20
    demand_pool = []
    
    for _ in range(pool_size):
        dem, _ = env.sample_demands_episode()
        demand_pool.append(dem)
    
    refresh_every = 30
    refresh_count = 4
    
    # Validation pool
    validation_pool = []
    for _ in range(12):
        dem, _ = env.sample_demands_episode()
        validation_pool.append(dem)
    
    current_params = get_flat_params(policy_net)
    current_reward = evaluate(env, policy_net, K_slow, demand_pool)
    
    best_reward = current_reward
    best_validation = evaluate(env, policy_net, 12, validation_pool)
    best_policy = copy.deepcopy(policy_net.state_dict())
    best_params = current_params.clone()
    torch.save(best_policy, save_f_path)
    
    stagnation_counter = 0
    recent_rewards = deque(maxlen=40)
    recent_deltas = deque(maxlen=30)
    
    # =========================
    # Layer-wise masks with importance weighting
    # =========================
    flat_dim = current_params.numel()
    layer_masks = {}
    layer_importance = {}
    
    idx = 0
    for name, p in policy_net.named_parameters():
        n = p.numel()
        mask = torch.zeros(flat_dim)
        mask[idx:idx+n] = 1.0
        layer_masks[name] = mask
        
        # Importance based on layer depth (output layer most important)
        if "fc3" in name:
            layer_importance[name] = 1.5
        elif "fc2" in name:
            layer_importance[name] = 1.0
        else:
            layer_importance[name] = 0.6
        idx += n
    
    # Combined masks
    last_layer_mask = sum([layer_masks[k] for k in layer_masks if "fc3" in k])
    mid_last_mask = sum([layer_masks[k] for k in layer_masks if "fc2" in k or "fc3" in k])
    
    # Importance-weighted scale
    scale = torch.ones(flat_dim)
    idx = 0
    for name, p in policy_net.named_parameters():
        n = p.numel()
        scale[idx:idx+n] = layer_importance[name]
        idx += n
    
    # =========================
    # Adaptive momentum tracking
    # =========================
    momentum = torch.zeros_like(current_params)
    momentum_beta = 0.7
    
    # =========================
    # Optimization loop
    # =========================
    for episode in tqdm(range(int(max_episodes)), desc="SA optimization"):
        
        flat = current_params.clone()
        
        # Strategic demand pool refresh
        if episode % refresh_every == 0 and episode > 0:
            for _ in range(refresh_count):
                j = np.random.randint(0, pool_size)
                dem, _ = env.sample_demands_episode()
                demand_pool[j] = dem
        
        # Progressive layer focusing (smoother transitions)
        progress = episode / max_episodes
        if progress < 0.35:
            mask = torch.ones_like(flat)
        elif progress < 0.65:
            mask = mid_last_mask
        else:
            mask = last_layer_mask
        
        # Adaptive exploration strategy
        if episode % jump_every == 0:
            # Lévy flight for global exploration
            step = torch.randn_like(flat) / (torch.rand_like(flat) ** 0.5 + 0.1)
            perturbation = noise * 1.8 * step
        elif len(recent_deltas) > 10 and np.mean(recent_deltas) > 0:
            # If improving, add momentum in successful direction
            perturbation = noise * torch.randn_like(flat) + 0.3 * momentum
        else:
            # Standard Gaussian perturbation
            perturbation = noise * torch.randn_like(flat)
        
        proposal = flat + perturbation * scale * mask
        
        set_flat_params(policy_net, proposal)
        
        # Two-stage evaluation
        candidate_fast = evaluate(env, policy_net, K_fast, demand_pool)
        
        if candidate_fast >= current_reward - 400:
            candidate_reward = evaluate(env, policy_net, K_slow, demand_pool)
        else:
            candidate_reward = candidate_fast
        
        recent_rewards.append(candidate_reward)
        
        # Adaptive threshold using quantile
        if len(recent_rewards) >= 15:
            threshold = np.percentile(recent_rewards, 50)
        else:
            threshold = current_reward
        
        delta = candidate_reward - threshold
        recent_deltas.append(delta)
        
        # Acceptance with temperature
        accept_prob = np.exp(delta / (T + 1e-8)) if delta < 0 else 1.0
        
        if delta > 0 or np.random.rand() < accept_prob:
            # Update momentum in direction of improvement
            momentum = momentum_beta * momentum + (1 - momentum_beta) * perturbation
            current_params = proposal
            current_reward = candidate_reward
        else:
            set_flat_params(policy_net, current_params)
        
        # =========================
        # Update best with validation check
        # =========================
        if current_reward > best_reward + 80:
            # Validate on separate dataset
            validation_score = evaluate(env, policy_net, 12, validation_pool)
            
            # Accept if validation improves or is close
            if validation_score > best_validation * 0.97:
                best_reward = current_reward
                best_validation = validation_score
                best_policy = copy.deepcopy(policy_net.state_dict())
                best_params = current_params.clone()
                torch.save(best_policy, save_f_path)
                stagnation_counter = 0
                noise *= 0.95
        else:
            stagnation_counter += 1
            if stagnation_counter % 25 == 0:
                noise *= 1.03
        
        noise = np.clip(noise, 0.015, 0.28)
        T = max(T * alpha, T_min)
        
        # Reheat if stuck
        if stagnation_counter > stagnation_limit:
            T = 2.0
            noise = base_noise * 1.3
            stagnation_counter = 0
            momentum = torch.zeros_like(momentum)
            
            # Restart from best with small perturbation
            current_params = best_params.clone() + 0.03 * torch.randn_like(best_params)
            set_flat_params(policy_net, current_params)
            current_reward = evaluate(env, policy_net, K_slow, demand_pool)
        
        # Periodic full validation
        if episode % 80 == 0 and episode > 0:
            val_score = evaluate(env, policy_net, 12, validation_pool)
            if val_score > best_validation * 1.01:
                best_validation = val_score
                best_reward = current_reward
                best_policy = copy.deepcopy(policy_net.state_dict())
                best_params = current_params.clone()
                torch.save(best_policy, save_f_path)
        
        plot_data["episodes"].append(episode)
        plot_data["reward_history"].append(best_reward)

        # -----------------------------------------------------------------------------------
        # PLEASE DO NOT MODIFY THE CODE BELOW THIS LINE
        # -----------------------------------------------------------------------------------
        if (time.time() - start_time) > max_time:
            break

    print(f"Policy model weights saved in: {save_f_path}")
    print(f"Best reward: {best_reward}")

    team_names = [
        "Del Rio Chanona, Antonio",
        "Fons, Isabela",
    ]
    cids = ["16879875", "06069513"]
    question = [1, 0]

    return best_policy, plot_data
