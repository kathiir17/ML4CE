# -------------------------------------------------------------
# GP_model class (your GP implementation, adapted)
# -------------------------------------------------------------
class GP_model:
    
    ###########################
    # --- initializing GP --- #
    ###########################    
    def __init__(self, X, Y, kernel, multi_hyper, var_out=True):
        """
        X: (n_points, n_features)
        Y: (n_points, n_outputs)  -> here n_outputs = 1
        kernel: string, e.g. 'RBF'
        multi_hyper: how many Sobol multistart points for hyperparameter optimisation
        var_out: if True, return variance as well as mean
        """
        # GP variable definitions
        self.X, self.Y, self.kernel = X, Y, kernel
        self.n_point, self.nx_dim   = X.shape[0], X.shape[1]
        self.ny_dim                 = Y.shape[1]
        self.multi_hyper            = multi_hyper
        self.var_out                = var_out
        
        # normalize data (zero mean, unit variance)
        self.X_mean, self.X_std     = np.mean(X, axis=0), np.std(X, axis=0) + 1e-12
        self.Y_mean, self.Y_std     = np.mean(Y, axis=0), np.std(Y, axis=0) + 1e-12
        self.X_norm, self.Y_norm    = (X-self.X_mean)/self.X_std, (Y-self.Y_mean)/self.Y_std
        
        # determine hyperparameters
        self.hypopt, self.invKopt   = self.determine_hyperparameters()        
    
    #############################
    # --- Covariance Matrix --- #
    #############################    
    def Cov_mat(self, kernel, X_norm, W, sf2):
        """
        Calculates the covariance matrix of a dataset X_norm
        Using RBF kernel with anisotropic weights W and variance sf2.
        """
        if kernel == 'RBF':
            dist       = cdist(X_norm, X_norm, 'seuclidean', V=W)**2 
            cov_matrix = sf2*np.exp(-0.5*dist)
            return cov_matrix
        else:
            raise ValueError(f"ERROR no kernel with name {kernel}")

    ################################
    # --- Covariance of sample --- #
    ################################    
    def calc_cov_sample(self, xnorm, Xnorm, ell, sf2):
        """
        Covariance of a single sample xnorm against dataset Xnorm.
        """
        nx_dim = self.nx_dim
        dist = cdist(Xnorm, xnorm.reshape(1, nx_dim), 'seuclidean', V=ell)**2
        cov_matrix = sf2 * np.exp(-0.5*dist)
        return cov_matrix                
        
    ###################################
    # --- negative log likelihood --- #
    ###################################   
    def negative_loglikelihood(self, hyper, X, Y):
        """
        Computes the negative log marginal likelihood for given hyperparameters.
        """
        n_point, nx_dim = self.n_point, self.nx_dim
        kernel          = self.kernel
        
        W   = np.exp(2*hyper[:nx_dim])    # W <=> 1/lambda
        sf2 = np.exp(2*hyper[nx_dim])     # variance of the signal 
        sn2 = np.exp(2*hyper[nx_dim+1])   # variance of noise

        K = self.Cov_mat(kernel, X, W, sf2)          # (n x n) covariance matrix (noise-free)
        K = K + (sn2 + 1e-8)*np.eye(n_point)         # add noise
        K = (K + K.T)*0.5                            # enforce symmetry
        L = np.linalg.cholesky(K)                    # Cholesky decomposition
        logdetK = 2 * np.sum(np.log(np.diag(L)))     # log(det(K))
        invLY   = np.linalg.solve(L, Y)              # L^{-1}Y
        alpha   = np.linalg.solve(L.T, invLY)        # (L^T L)^{-1}Y = K^{-1}Y
        NLL     = np.dot(Y.T, alpha) + logdetK       # negative log likelihood

        # Ensure scalar output
        return NLL.flatten()[0]
    
    ############################################################
    # --- Minimizing the NLL (hyperparameter optimization) --- #
    ############################################################   
    def determine_hyperparameters(self):
        """
        Hyperparameter optimisation using multistart and Sobol sequence.
        One GP (set of hyperparams) per output dimension.
        """   
        X_norm, Y_norm  = self.X_norm, self.Y_norm
        nx_dim, n_point = self.nx_dim, self.n_point
        kernel, ny_dim  = self.kernel, self.ny_dim
        Cov_mat         = self.Cov_mat
        
        lb      = np.array([-4.]*(nx_dim+1) + [-8.])   # lower bounds in log-space
        ub      = np.array([ 4.]*(nx_dim+1) + [ -2.])  # upper bounds in log-space
        bounds  = np.hstack((lb.reshape(nx_dim+2,1),
                             ub.reshape(nx_dim+2,1)))
        multi_start    = self.multi_hyper              # number of multistarts
        multi_startvec = sobol_seq.i4_sobol_generate(nx_dim + 2, multi_start)

        options  = {'disp': False, 'maxiter': 10000}
        hypopt   = np.zeros((nx_dim+2, ny_dim))
        localsol = [None]*multi_start
        localval = np.zeros((multi_start))

        invKopt = []

        # loop over outputs (GPs)
        for i in range(ny_dim):    
            # multistart over hyperparameters
            for j in range(multi_start):
                hyp_init = lb + (ub-lb)*multi_startvec[j, :]
                res = minimize(self.negative_loglikelihood, hyp_init,
                               args=(X_norm, Y_norm[:, i:i+1]),
                               method='SLSQP', options=options, bounds=bounds, tol=1e-12)
                localsol[j] = res.x
                localval[j] = res.fun

            # choose best solution
            minindex    = np.argmin(localval)
            hypopt[:,i] = localsol[minindex]
            ellopt      = np.exp(2.*hypopt[:nx_dim,i])
            sf2opt      = np.exp(2.*hypopt[nx_dim,i])
            sn2opt      = np.exp(2.*hypopt[nx_dim+1,i]) + 1e-8

            # construct optimal K
            Kopt        = Cov_mat(kernel, X_norm, ellopt, sf2opt) + sn2opt*np.eye(n_point)
            # invert K
            invKopt    += [np.linalg.solve(Kopt, np.eye(n_point))]

        return hypopt, invKopt

    ########################
    # --- GP inference --- #
    ########################     
    def GP_inference_np(self, x):
        """
        Predict mean and variance at a single input x (1D array of length nx_dim).
        """
        nx_dim                   = self.nx_dim
        kernel, ny_dim           = self.kernel, self.ny_dim
        hypopt, Cov_mat          = self.hypopt, self.Cov_mat
        stdX, stdY, meanX, meanY = self.X_std, self.Y_std, self.X_mean, self.Y_mean
        calc_cov_sample          = self.calc_cov_sample
        invKsample               = self.invKopt
        Xsample, Ysample         = self.X_norm, self.Y_norm
        var_out                  = self.var_out

        xnorm = (x - meanX)/stdX
        mean  = np.zeros(ny_dim)
        var   = np.zeros(ny_dim)
        # Loop over outputs (here ny_dim = 1)
        for i in range(ny_dim):
            invK           = invKsample[i]
            hyper          = hypopt[:, i]
            ellopt, sf2opt = np.exp(2*hyper[:nx_dim]), np.exp(2*hyper[nx_dim])

            # covariance between new point and training set
            k       = calc_cov_sample(xnorm, Xsample, ellopt, sf2opt)
            mean[i] = np.matmul(np.matmul(k.T, invK), Ysample[:, i:i+1])
            var[i]  = max(0, sf2opt - np.matmul(np.matmul(k.T, invK), k))  # numerical safe

        # un-normalize
        mean_sample = mean*stdY + meanY
        var_sample  = var*stdY**2
        
        if var_out:
            return mean_sample, var_sample
        else:
            return mean_sample.flatten()[0]

# -------------------------------------------------------------
# EI acquisition (no scipy.stats)
# -------------------------------------------------------------
def _erf_approx(z):
    sign = np.sign(z)
    x = np.abs(z)
    p = 0.3275911
    a1,a2,a3,a4,a5 = 0.254829592, -0.284496736, 1.421413741, -1.453152027, 1.061405429
    t = 1.0/(1.0 + p*x)
    poly = (((a5*t + a4)*t + a3)*t + a2)*t + a1
    y = 1.0 - poly * np.exp(-x*x)
    return sign * y

def _expected_improvement(mu, std, f_best, eps=1e-9):
    std = np.maximum(std, eps)
    z = (mu - f_best) / std
    pdf = np.exp(-0.5 * z**2) / np.sqrt(2.0 * np.pi)
    cdf = 0.5 * (1.0 + _erf_approx(z / np.sqrt(2.0)))
    ei = (mu - f_best) * cdf + std * pdf
    ei[std < eps] = 0.0
    return ei

# -------------------------------------------------------------
# BO class (uses GP_model instead of _SimpleGP)
# -------------------------------------------------------------
class BO:
    def __init__(self, X_initial, X_searchspace, iterations, batch, objective_func):
        start_time = datetime.timestamp(datetime.now())

        self.X_initial     = X_initial
        self.X_searchspace = X_searchspace
        self.iterations    = iterations
        self.batch         = batch

        # Initial evaluation and timing format like the example
        self.Y     = objective_func(self.X_initial)
        self.time  = [datetime.timestamp(datetime.now()) - start_time]
        self.time += [0] * (len(self.X_initial) - 1)
        start_time = datetime.timestamp(datetime.now())

        # Bounds for scaling (from grids)
        self.bounds = {
            'temp': (30.0, 40.0),
            'pH':   (6.0, 8.0),
            'f1':   (0.0, 50.0),
            'f2':   (0.0, 50.0),
            'f3':   (0.0, 50.0),
        }
        self.celltypes = ['celltype_1','celltype_2','celltype_3']

        # Encode pool; mark already evaluated
        self.pool_native = list(self.X_searchspace)
        self.pool_enc    = self._encode_batch(self.pool_native)
        done = set(tuple(x) for x in self.X_initial)
        self.taken_mask = np.array([tuple(x) in done for x in self.pool_native], dtype=bool)

        # Main BO loop
        for self.iteration in range(iterations):
            # Build training set (all evaluated points so far)
            X_train_native = self._history_native(self.pool_native, self.taken_mask, self.X_initial)
            X_train_enc    = self._encode_batch(X_train_native)
            Y_train        = self.Y.reshape(-1, 1)

            # Fit GP_model on current data
            gp = GP_model(X_train_enc, Y_train, kernel='RBF', multi_hyper=3, var_out=True)

            y_best = float(np.max(self.Y))

            # Select batch by EI (top-B points)
            valid = ~self.taken_mask
            if not np.any(valid):
                break

            X_candidates_enc = self.pool_enc[valid]
            valid_indices    = np.where(valid)[0]

            mus  = []
            stds = []
            for x_enc in X_candidates_enc:
                mean_sample, var_sample = gp.GP_inference_np(x_enc)
                mus.append(float(mean_sample[0]))
                stds.append(float(np.sqrt(var_sample[0])))
            mu  = np.array(mus)
            std = np.array(stds)

            ei = _expected_improvement(mu, std, y_best)
            if np.all(ei <= 0.0):
                break

            # pick top 'batch' EI points
            n_valid = len(valid_indices)
            k = min(self.batch, n_valid)
            idx_sorted = np.argsort(-ei)[:k]
            chosen_pool_indices = valid_indices[idx_sorted]
            batch_points = [self.pool_native[i] for i in chosen_pool_indices]

            # Evaluate batch
            Y_new = objective_func(batch_points)
            self.Y = np.concatenate([self.Y, Y_new])

            # Update taken_mask
            for idx in chosen_pool_indices:
                self.taken_mask[idx] = True

            # timing pattern: leader time + zeros
            self.time += [datetime.timestamp(datetime.now()) - start_time]
            self.time += [0] * (len(Y_new) - 1)
            start_time = datetime.timestamp(datetime.now())

    # ---------- encoding helpers ----------
    def _one_hot_celltype(self, ct):
        oh = np.zeros(3)
        oh[self.celltypes.index(ct)] = 1.0
        return oh

    def _scale(self, x, lo, hi):
        return (float(x) - lo) / (hi - lo + 1e-12)

    def _encode_point(self, x_native):
        t, pH, f1, f2, f3, ct = x_native
        cont = np.array([
            self._scale(t,  *self.bounds['temp']),
            self._scale(pH, *self.bounds['pH']),
            self._scale(f1, *self.bounds['f1']),
            self._scale(f2, *self.bounds['f2']),
            self._scale(f3, *self.bounds['f3']),
        ])
        cat = self._one_hot_celltype(ct)
        return np.concatenate([cont, cat], axis=0)

    def _encode_batch(self, X_native):
        return np.vstack([self._encode_point(x) for x in X_native])

    def _history_native(self, pool_native, taken_mask, X_initial):
        """
        Reconstructs the full list of evaluated points in the same order as self.Y.
        """
        xset = list(X_initial)
        init_set = set(tuple(xx) for xx in X_initial)
        for take, x in zip(taken_mask, pool_native):
            if take and (tuple(x) not in init_set):
                xset.append(x)
        return xset

