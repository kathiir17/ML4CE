# -------------------------------------------------------------
# High-Performance GP (Matern 5/2 + Normalization)
# -------------------------------------------------------------
class _SimpleGP:
    def __init__(self):
        self.X = None
        self.y = None
        self.y_norm = None
        self.y_mean = 0.0
        self.y_std = 1.0
        self.theta = None
        self.L = None
        self.alpha = None

    def _kernel(self, XA, XB, ell_cont, ell_cat, sigma2):
        XA_c, XA_k = XA[:, :5], XA[:, 5:]
        XB_c, XB_k = XB[:, :5], XB[:, 5:]
        
        # Continuous distance
        A_c = XA_c / (ell_cont + 1e-12)
        B_c = XB_c / (ell_cont + 1e-12)
        sq_dist_c = np.sum(A_c**2, axis=1)[:, None] + np.sum(B_c**2, axis=1)[None, :] - 2.0 * (A_c @ B_c.T)
        sq_dist_c = np.maximum(sq_dist_c, 0.0)
        
        # Categorical distance
        A_k = XA_k / (ell_cat + 1e-12)
        B_k = XB_k / (ell_cat + 1e-12)
        sq_dist_k = np.sum(A_k**2, axis=1)[:, None] + np.sum(B_k**2, axis=1)[None, :] - 2.0 * (A_k @ B_k.T)
        sq_dist_k = np.maximum(sq_dist_k, 0.0)
        
        d = np.sqrt(sq_dist_c + sq_dist_k)
        
        # Matern 5/2
        sqrt5_d = np.sqrt(5.0) * d
        K = sigma2 * (1.0 + sqrt5_d + (5.0/3.0) * (d**2)) * np.exp(-sqrt5_d)
        return K

    def _neg_log_mll(self, logtheta):
        log_ell_cont, log_ell_cat, log_sigma, log_noise = logtheta
        ell_cont = np.exp(log_ell_cont)
        ell_cat  = np.exp(log_ell_cat)
        sigma2   = np.exp(2.0 * log_sigma)
        noise2   = np.exp(2.0 * log_noise)

        K = self._kernel(self.X, self.X, ell_cont, ell_cat, sigma2)
        n = self.X.shape[0]
        K[np.diag_indices(n)] += noise2 + 1e-10
        
        try:
            L, lower = cho_factor(K, lower=True, check_finite=False)
            alpha = cho_solve((L, lower), self.y_norm, check_finite=False)
            logdet = 2.0 * np.sum(np.log(np.diag(L)))
            return 0.5 * (self.y_norm @ alpha) + 0.5 * logdet + 0.5 * n * np.log(2.0 * np.pi)
        except np.linalg.LinAlgError:
            return 1e50

    def fit(self, X_enc, y, optimize_hyperparams=True, maxfun=100, n_restarts=3):
        self.X = np.asarray(X_enc, float)
        self.y = np.asarray(y, float)

        # Normalize
        self.y_mean = np.mean(self.y)
        self.y_std = np.std(self.y) if len(self.y) > 1 and np.std(self.y) > 1e-9 else 1.0
        self.y_norm = (self.y - self.y_mean) / self.y_std

        if self.theta is None:
            self.theta = np.array([np.log(0.3), np.log(0.3), np.log(1.0), np.log(1e-4)])

        # --- UPDATED BOUNDS FOR DETERMINISTIC LAB ---
        # Since the lab code has a fixed seed (1234), it is deterministic.
        # We force the noise (log_noise) to be very small so the GP trusts the data fully.
        bounds = [
            (np.log(0.05), np.log(5.0)),   # log_ell_cont
            (np.log(0.05), np.log(5.0)),   # log_ell_cat
            (np.log(0.1),  np.log(10.0)),  # log_sigma
            (np.log(1e-6), np.log(1e-4))   # log_noise (TIGHTER BOUND)
        ]

        if optimize_hyperparams and len(self.y) >= 6:
            best_theta = self.theta
            best_mll = 1e100
            for i in range(n_restarts + 1):
                if i == 0: x0 = self.theta
                else:
                    x0 = np.array([
                        np.random.uniform(bounds[0][0], bounds[0][1]),
                        np.random.uniform(bounds[1][0], bounds[1][1]),
                        np.random.uniform(bounds[2][0], bounds[2][1]),
                        np.random.uniform(bounds[3][0], bounds[3][1])
                    ])
                try:
                    res = minimize(self._neg_log_mll, x0, method='L-BFGS-B', bounds=bounds,
                                   options={'maxfun': maxfun, 'maxiter': maxfun, 'ftol': 1e-6})
                    if res.fun < best_mll:
                        best_theta = res.x
                        best_mll = res.fun
                except: pass
            self.theta = best_theta

        self._refactor_fixed_theta()

    def predict(self, Xstar_enc):
        Xstar_enc = np.asarray(Xstar_enc, float)
        log_ell_cont, log_ell_cat, log_sigma, _ = self.theta
        ell_cont = np.exp(log_ell_cont)
        ell_cat  = np.exp(log_ell_cat)
        sigma2   = np.exp(2.0 * log_sigma)

        Kxs = self._kernel(Xstar_enc, self.X, ell_cont, ell_cat, sigma2)
        mu_norm = Kxs @ self.alpha
        v = cho_solve((self.L, True), Kxs.T, check_finite=False)
        kss = sigma2 * np.ones(Xstar_enc.shape[0])
        var_norm = kss - np.sum(Kxs * v.T, axis=1)
        
        # De-normalize
        mu = (mu_norm * self.y_std) + self.y_mean
        std = np.sqrt(np.maximum(var_norm, 1e-12)) * self.y_std
        return mu, std
        
    def _refactor_fixed_theta(self):
        log_ell_cont, log_ell_cat, log_sigma, log_noise = self.theta
        ell_cont = np.exp(log_ell_cont)
        ell_cat  = np.exp(log_ell_cat)
        sigma2   = np.exp(2.0 * log_sigma)
        noise2   = np.exp(2.0 * log_noise)

        K = self._kernel(self.X, self.X, ell_cont, ell_cat, sigma2)
        n = self.X.shape[0]
        K[np.diag_indices(n)] += noise2 + 1e-10
        self.L, lower = cho_factor(K, lower=True, check_finite=False)
        self.alpha = cho_solve((self.L, lower), self.y_norm, check_finite=False)

# -------------------------------------------------------------
# Acquisitions
# -------------------------------------------------------------
def _log_expected_improvement(mu, std, f_best, xi=0.01, eps=1e-9):
    std = np.maximum(std, eps)
    z = (mu - f_best - xi) / std
    log_ei = np.zeros_like(z)
    
    mask_safe = z > -6
    if np.any(mask_safe):
        z_s = z[mask_safe]
        std_s = std[mask_safe]
        pdf = stats.norm.pdf(z_s)
        cdf = stats.norm.cdf(z_s)
        ei_val = (mu[mask_safe] - f_best - xi) * cdf + std_s * pdf
        log_ei[mask_safe] = np.log(np.maximum(ei_val, 1e-100))
        
    mask_low = ~mask_safe
    if np.any(mask_low):
        z_l = z[mask_low]
        std_l = std[mask_low]
        log_phi = -0.5 * z_l**2 - 0.91893853
        log_ei[mask_low] = np.log(std_l) + log_phi - 2 * np.log(np.abs(z_l))
    return log_ei

def _ucb(mu, std, kappa=2.0):
    return mu + kappa * std

# -------------------------------------------------------------
# BO class
# -------------------------------------------------------------
class BO:
    def __init__(self, X_initial, X_searchspace, iterations, batch, objective_func):
        start_time = datetime.timestamp(datetime.now())

        self.X_initial     = X_initial
        self.X_searchspace = X_searchspace
        self.iterations    = iterations
        self.batch         = batch

        # Initial evaluation
        self.Y     = objective_func(self.X_initial)
        self.time  = [datetime.timestamp(datetime.now()) - start_time]
        self.time += [0] * (len(self.X_initial) - 1)
        start_time = datetime.timestamp(datetime.now())

        self.bounds = {
            'temp': (30.0, 40.0), 'pH': (6.0, 8.0),
            'f1': (0.0, 50.0), 'f2': (0.0, 50.0), 'f3': (0.0, 50.0),
        }
        self.celltypes = ['celltype_1','celltype_2','celltype_3']

        self.pool_native = list(self.X_searchspace)
        self.pool_enc    = self._encode_batch(self.pool_native)
        done = set(tuple(x) for x in self.X_initial)
        self.taken_mask = np.array([tuple(x) in done for x in self.pool_native], dtype=bool)

        # Fit initial GP
        self.gp = _SimpleGP()
        X0_enc = self._encode_batch(self.X_initial)
        if len(self.Y) >= 6:
            self.gp.fit(X0_enc, self.Y, optimize_hyperparams=True, maxfun=100, n_restarts=5)

        # Main loop
        for self.iteration in range(iterations):
            y_best = float(np.max(self.Y))
            
            # --- ADAPTIVE ZOOM ---
            decay_factor = 1.0 - (self.iteration / self.iterations)
            current_radius = 0.01 + (0.14 * decay_factor)
            if self.iteration > 0:
                self._augment_pool_adaptive(n_new=600, radius=current_radius, top_k=3)

            if self.iteration % 5 == 0:
                valid = ~self.taken_mask
                candidates = np.where(valid)[0]
                n_pick = min(self.batch, len(candidates))
                chosen_idx = np.random.choice(candidates, size=n_pick, replace=False)
                batch_points = [self.pool_native[i] for i in chosen_idx]
            else:
                batch_points, chosen_idx = self._select_batch_kb(
                    y_best, self.batch, self.taken_mask.copy()
                )

            if len(batch_points) == 0: break

            Y_new = objective_func(batch_points)
            self.Y = np.concatenate([self.Y, Y_new])

            for idx in chosen_idx:
                self.taken_mask[idx] = True

            self.time += [datetime.timestamp(datetime.now()) - start_time]
            self.time += [0] * (len(Y_new) - 1)
            start_time = datetime.timestamp(datetime.now())

            # Refit
            X_all_native = self._history_native(self.pool_native, self.taken_mask, self.X_initial)
            X_all_enc = self._encode_batch(X_all_native)
            self.gp.fit(X_all_enc, self.Y, optimize_hyperparams=True, maxfun=100, n_restarts=3)

    def _augment_pool_adaptive(self, n_new=500, radius=0.1, top_k=3):
        top_indices = np.argsort(self.Y)[-top_k:]
        X_history_native = self._history_native(self.pool_native, self.taken_mask, self.X_initial)
        new_candidates = []
        points_per_peak = n_new // top_k
        
        for idx in top_indices:
            center_point = X_history_native[idx]
            for _ in range(points_per_peak):
                cand = list(center_point)
                for dim in range(5):
                    keys = ['temp','pH','f1','f2','f3']
                    b_lo, b_hi = self.bounds[keys[dim]]
                    span = b_hi - b_lo
                    noise = np.random.normal(0, radius * span)
                    val = np.clip(cand[dim] + noise, b_lo, b_hi)
                    cand[dim] = float(val)
                if np.random.rand() < 0.1:
                    cand[5] = random.choice(self.celltypes)
                new_candidates.append(cand)
            
        new_enc = self._encode_batch(new_candidates)
        self.pool_native.extend(new_candidates)
        self.pool_enc = np.vstack([self.pool_enc, new_enc])
        new_mask = np.zeros(len(new_candidates), dtype=bool)
        self.taken_mask = np.concatenate([self.taken_mask, new_mask])

    def _select_batch_kb(self, y_best, batch_size, taken_mask_copy):
        chosen_idxs = []
        believer = _SimpleGP()
        believer.X = self.gp.X.copy()
        believer.y = self.gp.y.copy()
        believer.y_norm = self.gp.y_norm.copy()
        believer.y_mean = self.gp.y_mean
        believer.y_std = self.gp.y_std
        believer.theta = self.gp.theta
        believer.L = self.gp.L
        believer.alpha = self.gp.alpha

        for i in range(batch_size):
            valid = ~taken_mask_copy
            if not np.any(valid): break

            if i == 0:
                j_pool = np.random.choice(np.where(valid)[0])
            elif i == 1:
                mu, std = believer.predict(self.pool_enc[valid])
                acq = _ucb(mu, std, kappa=2.0)
                j_valid = int(np.argmax(acq))
                j_pool = np.where(valid)[0][j_valid]
            else:
                mu, std = believer.predict(self.pool_enc[valid])
                log_ei = _log_expected_improvement(mu, std, y_best)
                if np.all(log_ei <= -20.0):
                    j_pool = np.random.choice(np.where(valid)[0])
                else:
                    j_valid = int(np.argmax(log_ei))
                    j_pool = np.where(valid)[0][j_valid]

            x_new_enc = self.pool_enc[j_pool:j_pool + 1]
            mu_new, _ = believer.predict(x_new_enc)

            believer.X = np.vstack([believer.X, x_new_enc])
            believer.y = np.concatenate([believer.y, mu_new])
            believer.y_norm = (believer.y - believer.y_mean) / believer.y_std
            believer._refactor_fixed_theta()

            taken_mask_copy[j_pool] = True
            chosen_idxs.append(j_pool)

        batch_native = [self.pool_native[i] for i in chosen_idxs]
        return batch_native, chosen_idxs
    
    def _one_hot_celltype(self, ct):
        oh = np.zeros(3)
        oh[self.celltypes.index(ct)] = 1.0
        return oh
    def _scale(self, x, lo, hi): return (float(x) - lo) / (hi - lo + 1e-12)
    def _encode_point(self, x_native):
        t, pH, f1, f2, f3, ct = x_native
        cont = np.array([
            self._scale(t,  *self.bounds['temp']),
            self._scale(pH, *self.bounds['pH']),
            self._scale(f1, *self.bounds['f1']),
            self._scale(f2, *self.bounds['f2']),
            self._scale(f3, *self.bounds['f3']),
        ])
        cat = self._one_hot_celltype(ct)
        return np.concatenate([cont, cat], axis=0)
    def _encode_batch(self, X_native): return np.vstack([self._encode_point(x) for x in X_native])
    def _history_native(self, pool_native, taken_mask, X_initial):
        xset = list(X_initial)
        init_set = set(tuple(xx) for xx in X_initial)
        for take, x in zip(taken_mask, pool_native):
            if take and (tuple(x) not in init_set):
                xset.append(x)
        return xset

