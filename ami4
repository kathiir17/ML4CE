bounds = np.array([[30.0, 40.0], [6.0, 8.0], [0.0, 50.0], [0.0, 50.0], [0.0, 50.0]])
celltypes = ['celltype_1','celltype_2','celltype_3']

def make_initial_design(n_init=6):
    X_init = []
    for i in range(n_init):
        u, _ = i4_sobol(dim_num=5, seed=i)
        cont = bounds[:,0] + u*(bounds[:,1] - bounds[:,0])
        ct = celltypes[i % len(celltypes)]
        X_init.append([float(cont[0]), float(cont[1]), float(cont[2]), float(cont[3]), float(cont[4]), ct])
    return X_init

def make_candidate_pool(n_candidates=3000): 
    X_searchspace = []
    for i in range(n_candidates):
        u, _ = i4_sobol(dim_num=5, seed=i+100)
        cont = bounds[:,0] + u*(bounds[:,1] - bounds[:,0])
        ct = random.choice(celltypes)
        X_searchspace.append([float(cont[0]), float(cont[1]), float(cont[2]), float(cont[3]), float(cont[4]), ct])
    return X_searchspace

X_initial = make_initial_design(n_init=6)
X_searchspace = make_candidate_pool(n_candidates=3000)
BO_m = BO(X_initial, X_searchspace, 15, 5, objective_func)

